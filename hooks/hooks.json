{
  "description": "Kunskap session sync. Pull shared vault on session start; commit + push inbox writes asynchronously per-write. No-op in projects without .claude/kunskap.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-write-sync.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
