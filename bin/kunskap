#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kunskap"
IDENTITY_FILE="$CONFIG_DIR/identity.toml"

# Global state set by the pre-dispatch parser in main().
GLOBAL_VAULT=""

die() { echo "kunskap: $*" >&2; exit 1; }

plugin_root() {
  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
    return
  fi
  # Resolve symlinks so a ~/bin/kunskap → /opt/kunskap/bin/kunskap shim
  # still finds the plugin's agents/ at /opt/kunskap. macOS BSD readlink
  # has no -f, so walk the chain by hand.
  local src="$0" dir
  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  (cd -P "$(dirname "$src")/.." && pwd)
}

validate_vault() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -d "$vault" ]] || die "vault path not found: $vault"
  [[ -f "$vault/_meta/kunskap.toml" ]] || die "not a kunskap vault (missing _meta/kunskap.toml): $vault"
  [[ -d "$vault/raw/inbox" ]] || die "not a kunskap vault (missing raw/inbox/): $vault"
}

cmd_help() {
  cat <<EOF
kunskap $VERSION — knowledge-base plugin

Usage:
  kunskap version | --version
  kunskap help    | --help
  kunskap config user --name <lowercase-slug> [--email <addr>] [--host <host>]
  kunskap config show
  kunskap [--vault <abs-path>] config get <key>
  kunskap whoami [--quiet]
  kunskap learn enable --vault <abs-path> [--yes]
  kunskap learn disable
  kunskap learn status
  kunskap curate --vault <abs-path> [--check]
  kunskap link-stubs --vault <abs-path> [--format text|json]
  kunskap audit-coverage --vault <abs-path> [--format text|json]

Notes:
  --host is recommended on \`config user\`. Without it, host derives from
  \`hostname -s\` which mutates on machine renames and silently breaks role
  checks at P5. See docs/kunskap-design.md §Q5 (Identity bootstrapping)
  and Risk #5 (Identity fragility).

  \`learn enable\` writes \`.claude/kunskap.json\` in the current project
  pointing at the given vault. Confirmation is required (Risk #7 — vault-leak
  between projects); set KUNSKAP_AUTO_CONFIRM=1 or pass --yes for scripts.

  \`config get <key>\` with --vault reads from <vault>/_meta/kunskap.toml
  (keys: shared, name, created, schema_version); without --vault reads from
  identity.toml (keys: name, email, host). Missing vault config file is
  fail-soft: \`shared\` returns "false", other keys return empty.

  \`curate\` spawns the curator agent headlessly via \`claude --plugin-dir\`.
  Requires Claude Code on PATH and Anthropic auth configured.

  \`link-stubs\` and \`audit-coverage\` are pure-shell — no LLM, no auth.
EOF
}

write_identity() {
  local name="$1" email="$2" host="$3"
  mkdir -p "$CONFIG_DIR"
  {
    echo "# kunskap identity — written by \`kunskap config user\`. Edit by hand if needed."
    echo "[user]"
    echo "name  = \"$name\""
    [[ -n "$email" ]] && echo "email = \"$email\""
    echo "host  = \"$host\""
  } > "$IDENTITY_FILE"
}

# Read a single TOML field from <section>.<field>. Hand-rolled regex parser —
# tolerates `key = "value"` and bare `key = value` forms, ignores comments,
# returns the raw value or empty string. Full TOML compliance is P5's job.
read_toml_field() {
  local file="$1" section="$2" field="$3"
  [[ -f "$file" ]] || return 1
  awk -v sec="[$section]" -v f="$field" '
    $0 == sec    { in_sec = 1; next }
    /^\[/        { in_sec = 0; next }
    in_sec && $1 == f {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]*(#.*)?$/, "")
      sub(/^"/, ""); sub(/"$/, "")
      print
      exit
    }
  ' "$file"
}

read_identity_field() {
  read_toml_field "$IDENTITY_FILE" user "$1"
}

# --name is lowercase-only to pre-empt Paul/paul collisions in the P5
# role-check (identity-string = <name>@<host>); --host stays mixed-case
# because `hostname -s` commonly returns capitalized values.
validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9._-]{0,63}$ ]] \
    || die "--name must match [a-z][a-z0-9._-]{0,63} (lowercase); got: $1"
}
validate_host() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]{1,64}$ ]] \
    || die "--host must match [a-zA-Z0-9._-]{1,64}; got: $1"
}
validate_email() {
  [[ "$1" != *['"'\\$'\n']* ]] \
    || die "--email must not contain quote, backslash, or newline; got: $1"
}

# Validates the value following a flag. Rejects missing, empty, and
# `-`-prefixed values (the last would silently swallow the next flag —
# Pass-2 bug: `--host --email <addr>` parsed host=`--email`).
# Called outside command substitution so `die` exits the script (bash
# quirk: var=$(die …) does NOT propagate exit under set -e).
require_value() {
  local flag="$1" next="$2"
  [[ "$next" != "__MISSING__" ]] || die "$flag requires a value"
  [[ -n "$next" ]]                || die "$flag requires a non-empty value"
  [[ "$next" != -* ]]             || die "$flag requires a value (got next flag: $next)"
}

cmd_config_user() {
  local name="" email="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  require_value --name  "${2-__MISSING__}"; name="$2";  shift 2 ;;
      --email) require_value --email "${2-__MISSING__}"; email="$2"; shift 2 ;;
      --host)  require_value --host  "${2-__MISSING__}"; host="$2";  shift 2 ;;
      *) die "unknown flag for \`config user\`: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "config user: --name <slug> is required"
  validate_name "$name"
  [[ -z "$email" ]] || validate_email "$email"
  [[ -z "$host" ]] || validate_host "$host"

  if [[ -z "$host" ]]; then
    host="$(hostname -s)"
    echo "kunskap: host derived from \`hostname -s\` ($host); explicit --host recommended for stable role-checks (see Risk #5)." >&2
  fi

  write_identity "$name" "$email" "$host"
  echo "kunskap: identity written to $IDENTITY_FILE ($name@$host)"
}

cmd_config_show() {
  [[ $# -eq 0 ]] || die "config show: takes no arguments (got: $*)"
  [[ -f "$IDENTITY_FILE" ]] || die "no identity at $IDENTITY_FILE — run \`kunskap config user --name <slug>\`"
  cat "$IDENTITY_FILE"
}

cmd_config_get() {
  [[ $# -eq 1 ]] || die "config get: takes exactly one <key> argument (got: $*)"
  local key="$1"

  if [[ -n "$GLOBAL_VAULT" ]]; then
    local file="$GLOBAL_VAULT/_meta/kunskap.toml"
    case "$key" in
      shared|name|created|schema_version) ;;
      *) die "config get: unknown vault key: $key (allowed: shared, name, created, schema_version)" ;;
    esac
    if [[ ! -f "$file" ]]; then
      # Fail-soft: P3 ships `kunskap init`, so vaults predate _meta/kunskap.toml.
      # Hooks treat missing-or-unknown as not-shared and skip pull/push.
      [[ "$key" == "shared" ]] && echo "false"
      return 0
    fi
    read_toml_field "$file" vault "$key"
    return 0
  fi

  case "$key" in
    name|email|host) ;;
    *) die "config get: unknown user key: $key (allowed: name, email, host); use --vault for vault keys" ;;
  esac
  [[ -f "$IDENTITY_FILE" ]] || return 0
  read_identity_field "$key"
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    user) cmd_config_user "$@" ;;
    show) cmd_config_show "$@" ;;
    get)  cmd_config_get "$@"  ;;
    "")   die "config: subcommand required (user | show | get)" ;;
    *)    die "config: unknown subcommand: $sub" ;;
  esac
}

cmd_whoami() {
  local quiet=false
  if [[ "${1:-}" == "--quiet" ]]; then
    quiet=true
    shift
  fi
  [[ $# -eq 0 ]] || die "whoami: takes no positional arguments (got: $*)"
  local name host
  if ! name="$(read_identity_field name)" || [[ -z "$name" ]]; then
    $quiet || echo "kunskap: identity not set — run \`kunskap config user --name <slug>\`" >&2
    exit 1
  fi
  if ! host="$(read_identity_field host)" || [[ -z "$host" ]]; then
    $quiet || echo "kunskap: identity missing host — re-run \`kunskap config user\`" >&2
    exit 1
  fi
  $quiet || echo "$name@$host"
}

# Project root is whatever Claude Code told us (CLAUDE_PROJECT_DIR), or, when
# the user invokes the CLI directly, the current working directory.
project_dir() {
  printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

marker_path() {
  printf '%s/.claude/kunskap.json\n' "$(project_dir)"
}

# Looser than validate_vault — `learn enable` may point at a not-yet-init'd
# vault (P3 ships `kunskap init`), so we only require absolute + extant + dir.
validate_vault_loose() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -e "$vault" ]] || die "--vault path does not exist: $vault"
  [[ -d "$vault" ]] || die "--vault path is not a directory: $vault"
}

cmd_learn_enable() {
  local vault="" yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --yes|-y) yes=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "learn enable: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "learn enable: unknown extra args: ${extra[*]}"
  validate_vault_loose "$vault"

  # Risk #7 (vault-leak between projects) mitigation. The marker file is the
  # privacy primitive — wrong vault = personal notes pushed to the team's
  # research vault, or vice versa. Confirm before writing.
  local proj
  proj="$(project_dir)"

  if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
    printf 'Enable Kunskap in %s pointed at %s? (y/N) ' "$proj" "$vault" >&2
    local reply=""
    read -r reply || true
    [[ "$reply" =~ ^[Yy]$ ]] || die "learn enable: cancelled (no marker written)"
  fi

  local marker confirmed_at
  marker="$(marker_path)"
  confirmed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$marker")"
  cat > "$marker" <<EOF
{
  "vault": "$vault",
  "enabled": true,
  "confirmed_at": "$confirmed_at"
}
EOF
  echo "kunskap: enabled in $proj. Vault: $vault. Run \`kunskap learn status\` (or /kunskap:learn status) to verify."
}

cmd_learn_disable() {
  [[ $# -eq 0 ]] || die "learn disable: takes no arguments (got: $*)"
  local proj marker
  proj="$(project_dir)"
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "kunskap: not enabled in $proj (no marker at $marker)"
    return 0
  fi
  rm -f "$marker"
  echo "kunskap: disabled in $proj (removed $marker)"
}

# Days between two ISO-8601 dates (UTC, day precision). Pure-shell so we don't
# depend on GNU date or BSD date flag-shape differences.
days_since() {
  local iso="$1" now_epoch then_epoch
  # Strip the time portion; keep YYYY-MM-DD.
  iso="${iso:0:10}"
  [[ "$iso" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "?"; return; }
  now_epoch=$(date -u +%s)
  if then_epoch=$(date -u -j -f "%Y-%m-%d" "$iso" +%s 2>/dev/null); then :
  elif then_epoch=$(date -u -d "$iso" +%s 2>/dev/null); then :
  else echo "?"; return
  fi
  printf '%d\n' "$(( (now_epoch - then_epoch) / 86400 ))"
}

cmd_learn_status() {
  [[ $# -eq 0 ]] || die "learn status: takes no arguments (got: $*)"
  local marker
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "STATUS: disabled (no marker at $marker)"
    return 0
  fi

  local vault enabled confirmed_at
  vault="$(jq -r '.vault // ""' "$marker" 2>/dev/null || true)"
  enabled="$(jq -r '.enabled // false' "$marker" 2>/dev/null || true)"
  confirmed_at="$(jq -r '.confirmed_at // ""' "$marker" 2>/dev/null || true)"

  echo "STATUS: ${enabled:-unknown}"
  echo "VAULT:  ${vault:-<unset>}"

  local identity name host
  if name="$(read_identity_field name 2>/dev/null)" && [[ -n "$name" ]] \
     && host="$(read_identity_field host 2>/dev/null)" && [[ -n "$host" ]]; then
    identity="$name@$host"
    echo "IDENTITY: $identity"
  else
    identity=""
    echo "IDENTITY: not set — run \`kunskap config user --name <slug> --host <host>\`"
  fi

  if [[ -z "$vault" || ! -d "$vault" ]]; then
    echo "SHARED: unknown — vault path missing or unreadable"
  elif [[ ! -f "$vault/_meta/kunskap.toml" ]]; then
    echo "SHARED: unknown — vault not initialized (P3: \`kunskap init\`)"
  else
    local shared
    shared="$(read_toml_field "$vault/_meta/kunskap.toml" vault shared 2>/dev/null || true)"
    echo "SHARED: ${shared:-unknown}"
  fi

  # Risk #5 (identity fragility) cross-check: if identity-string appears as a
  # role primary in any roles.toml section, status confirms; mismatch warns.
  local roles_file="$vault/_meta/roles.toml"
  if [[ -n "$identity" && -f "$roles_file" ]]; then
    local matched=""
    for role in curator linter; do
      local primary
      primary="$(read_toml_field "$roles_file" "roles.$role" primary 2>/dev/null || true)"
      [[ "$primary" == "$identity" ]] && matched="$matched $role"
    done
    if [[ -n "$matched" ]]; then
      echo "ROLE-CHECK: primary for$matched"
    else
      local cur lin
      cur="$(read_toml_field "$roles_file" roles.curator primary 2>/dev/null || true)"
      lin="$(read_toml_field "$roles_file" roles.linter  primary 2>/dev/null || true)"
      echo "ROLE-CHECK: not primary (curator: ${cur:-<unset>}; linter: ${lin:-<unset>})"
    fi
  elif [[ -n "$identity" ]]; then
    echo "ROLE-CHECK: no roles file (vault not yet initialized — P3/P5)"
  else
    echo "ROLE-CHECK: skipped (identity not set)"
  fi

  if [[ -n "$confirmed_at" ]]; then
    local days
    days="$(days_since "$confirmed_at")"
    if [[ "$days" =~ ^[0-9]+$ ]]; then
      echo "CONFIRMED: $confirmed_at (${days}d ago)"
      # Risk #7 (vault-leak) staleness warning.
      if (( days > 30 )); then
        echo "WARNING: confirmation is >30 days old. Re-run \`kunskap learn enable --vault <path>\` to re-confirm the binding (Risk #7)." >&2
      fi
    else
      echo "CONFIRMED: $confirmed_at (age unparseable)"
    fi
  else
    echo "CONFIRMED: <unset>"
  fi
}

cmd_learn() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    enable)  cmd_learn_enable  "$@" ;;
    disable) cmd_learn_disable "$@" ;;
    status)  cmd_learn_status  "$@" ;;
    "")      die "learn: subcommand required (enable | disable | status)" ;;
    *)       die "learn: unknown subcommand: $sub" ;;
  esac
}

cmd_curate() {
  local vault="" check=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --check) check=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "curate: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "curate: unknown extra args: ${extra[*]}"
  validate_vault "$vault"
  $check && { echo "kunskap: vault $vault looks healthy"; return 0; }

  local root prompt
  root="$(plugin_root)"
  [[ -f "$root/agents/curator.md" ]] \
    || die "curate: curator agent not found at $root/agents/curator.md (plugin_root resolved to $root; set CLAUDE_PLUGIN_ROOT to override)"
  command -v claude >/dev/null || die "curate: \`claude\` not on PATH; install Claude Code first"
  prompt="You have one task: invoke the \`curator\` subagent (defined in this plugin's agents/curator.md) via the Agent tool, passing this exact string as its ARGUMENTS:

$vault

The curator's system prompt already encodes the full §Curator contract — it knows what to do once it has the vault path. Do NOT attempt the curation work yourself; the curator subagent must own it. Do not write outside $vault. Do not modify this plugin repo. Report the curator's summary back when it returns."

  exec claude --plugin-dir "$root" --permission-mode acceptEdits -p "$prompt"
}

cmd_link_stubs() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "link-stubs: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "link-stubs: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "link-stubs: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # One pass: walk wiki/, harvest filename + aliases from frontmatter and
      # [[wikilinks]] from body in the same read. Frontmatter is the FIRST
      # ---/--- pair only; body --- separators stay body.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) {
        n = split(f, parts, "/")
        bn = parts[n]; sub(/\.md$/, "", bn)
        files[bn] = f
        in_fm = 0; fm_done = 0; ln = 0
        while ((getline line < f) > 0) {
          ln++
          if (!fm_done) {
            if (ln == 1) {
              if (line == "---") { in_fm = 1; continue }
              fm_done = 1
            } else if (in_fm && line == "---") {
              in_fm = 0; fm_done = 1; continue
            }
          }
          if (in_fm && line ~ /^aliases:/) {
            sub(/^aliases:[[:space:]]*\[?/, "", line)
            sub(/\]?[[:space:]]*$/, "", line)
            n2 = split(line, al, /,[[:space:]]*/)
            for (i = 1; i <= n2; i++) {
              gsub(/^"|"$|^'\''|'\''$/, "", al[i])
              if (al[i] != "") aliases[al[i]] = bn
            }
            continue
          }
          if (fm_done) {
            rest = line
            while (match(rest, /\[\[[^]]+\]\]/)) {
              link = substr(rest, RSTART + 2, RLENGTH - 4)
              sub(/\|.*$/, "", link)
              if (link != "") counts[link]++
              rest = substr(rest, RSTART + RLENGTH)
            }
          }
        }
        close(f)
      }
      close(cmd)

      if (outfmt == "json") printf "{\n"

      for (link in counts) {
        c = counts[link]
        kebab = link
        gsub(/[[:space:]]+/, "-", kebab); kebab = tolower(kebab)
        # Resolved: exact filename match OR an existing aliases: entry resolves it.
        # Needs-alias: kebab match exists but the natural-language form is not declared.
        if (link in files || link in aliases)        classify(link, c, "resolved")
        else if (kebab in files)                     classify(link, c, "needs-alias")
        else if (c >= 2)                             classify(link, c, "needs-stub")
        else                                          classify(link, c, "orphan")
      }

      if (outfmt == "json") {
        flush_json("resolved");  flush_json("needs-alias")
        flush_json("needs-stub"); flush_json("orphan")
        printf "\n}\n"
      } else {
        report("needs-stub",  "Multi-ref stubs (>=2 refs, no file) — write a concept stub:")
        report("orphan",      "Single-ref orphans (1 ref, no file) — leave as aspirational:")
        report("needs-alias", "Name-mismatch (kebab matches file, alias not declared) — curator should add aliases:")
        report("resolved",    "Resolved links — OK:")
      }
    }
    function classify(link, c, kind,    rec) {
      rec = link "\t" c
      buckets[kind] = buckets[kind] (buckets[kind] ? "\n" : "") rec
    }
    function flush_json(kind,    n, lines, i, sep, pair) {
      if (! (kind in buckets)) { printf "%s  \"%s\": []", (printed ? ",\n" : ""), kind; printed = 1; return }
      printf "%s  \"%s\": [", (printed ? ",\n" : ""), kind
      n = split(buckets[kind], lines, "\n")
      sep = ""
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        gsub(/\\/, "\\\\", pair[1]); gsub(/"/, "\\\"", pair[1])
        printf "%s\n    {\"link\": \"%s\", \"refs\": %d}", sep, pair[1], pair[2]
        sep = ","
      }
      printf "\n  ]"
      printed = 1
    }
    function report(kind, header,    n, lines, i, pair) {
      print header
      if (! (kind in buckets)) { print "  (none)\n"; return }
      n = split(buckets[kind], lines, "\n")
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        printf "  [%dx] %s\n", pair[2], pair[1]
      }
      print ""
    }
  ' </dev/null
}

cmd_audit_coverage() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "audit-coverage: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "audit-coverage: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "audit-coverage: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # 1. Collect all source files that exist (inbox + archive).
      collect_sources(vault "/raw/inbox",                "raw/inbox")
      collect_sources(vault "/Archives/processed-inbox", "Archives/processed-inbox")

      # 2. Collect every sources: entry from every wiki article.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) parse_sources(f)
      close(cmd)

      # 3. Compute silent-drops + broken-provenance.
      n_drop = 0; n_broken = 0
      for (s in sources_present)        if (!(s in sources_cited)) drops[++n_drop] = s
      for (s in sources_cited)          if (!(s in sources_present)) broken[++n_broken] = s
      for (s in sources_cited)
        if (s in sources_present)
          covered[++n_cov] = s

      if (outfmt == "json") {
        printf "{\n  \"silent_drops\": ["
        for (i = 1; i <= n_drop; i++) printf "%s\"%s\"", (i>1?", ":""), drops[i]
        printf "],\n  \"broken_provenance\": ["
        for (i = 1; i <= n_broken; i++) printf "%s\"%s\"", (i>1?", ":""), broken[i]
        printf "],\n  \"covered_count\": %d\n}\n", n_cov
      } else {
        printf "Silent drops (file present, no article cites it):\n"
        if (n_drop == 0) print "  (none)"
        for (i = 1; i <= n_drop; i++) printf "  %s\n", drops[i]
        printf "\nBroken provenance (article cites missing file):\n"
        if (n_broken == 0) print "  (none)"
        for (i = 1; i <= n_broken; i++) printf "  %s\n", broken[i]
        printf "\nCovered: %d source files cited by at least one article.\n", n_cov
      }

      if (n_drop > 0 || n_broken > 0) exit 2
    }
    function collect_sources(dir, prefix,    cmd, line, base, rel) {
      cmd = "find \"" dir "\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline line) > 0) {
        base = line
        sub(/.*\//, "", base)
        rel = prefix "/" base
        sources_present[rel] = 1
      }
      close(cmd)
    }
    function parse_sources(f,    line, infm, insrc) {
      infm = 0; insrc = 0
      while ((getline line < f) > 0) {
        if (line == "---") { if (!infm) infm = 1; else { close(f); return }; continue }
        if (!infm) continue
        if (line ~ /^sources:/) { insrc = 1
          # inline form: sources: [a, b]
          if (line ~ /\[/) {
            sub(/^sources:[[:space:]]*\[/, "", line)
            sub(/\][[:space:]]*$/, "", line)
            n = split(line, items, /,[[:space:]]*/)
            for (i = 1; i <= n; i++) {
              gsub(/^[[:space:]"'\'']+|[[:space:]"'\'']+$/, "", items[i])
              if (items[i] != "") sources_cited[items[i]] = 1
            }
            insrc = 0
          }
          continue
        }
        if (insrc) {
          if (line ~ /^[[:space:]]*-[[:space:]]/) {
            entry = line
            sub(/^[[:space:]]*-[[:space:]]*/, "", entry)
            gsub(/^["'\''[:space:]]+|["'\''[:space:]]+$/, "", entry)
            if (entry != "") sources_cited[entry] = 1
          } else if (line ~ /^[^[:space:]]/) {
            # next top-level key — sources block ended
            insrc = 0
          }
        }
      }
      close(f)
    }
  ' </dev/null
}

main() {
  # Pre-dispatch global flags. Currently just `--vault` for `config get`.
  # Consumed only when they precede the first non-flag token; subcommand-local
  # `--vault` flags (`curate --vault X`, `learn enable --vault X`) are still
  # parsed inside their subcommand.
  while [[ $# -gt 0 && "$1" == --vault ]]; do
    require_value --vault "${2-__MISSING__}"
    GLOBAL_VAULT="$2"
    shift 2
  done

  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    version|--version)        echo "kunskap $VERSION" ;;
    help|--help|-h)           cmd_help ;;
    config)                   cmd_config "$@" ;;
    whoami)                   cmd_whoami "$@" ;;
    learn)                    cmd_learn "$@" ;;
    curate)                   cmd_curate "$@" ;;
    link-stubs)               cmd_link_stubs "$@" ;;
    audit-coverage)           cmd_audit_coverage "$@" ;;
    *) die "unknown subcommand: $cmd (try \`kunskap help\`)" ;;
  esac
}

main "$@"
