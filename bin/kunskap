#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kunskap"
IDENTITY_FILE="$CONFIG_DIR/identity.toml"

die() { echo "kunskap: $*" >&2; exit 1; }

# Resolve the plugin root from CLAUDE_PLUGIN_ROOT (set by Claude Code when
# bin/ is on the plugin PATH) or by walking up from this script's location.
plugin_root() {
  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
    return
  fi
  local self
  self="$(cd "$(dirname "$0")/.." && pwd)"
  printf '%s\n' "$self"
}

validate_vault() {
  local vault="$1"
  [[ -d "$vault" ]] || die "vault path not found: $vault"
  [[ -f "$vault/_meta/kunskap.toml" ]] || die "not a kunskap vault (missing _meta/kunskap.toml): $vault"
  [[ -d "$vault/raw/inbox" ]] || die "not a kunskap vault (missing raw/inbox/): $vault"
}

cmd_help() {
  cat <<EOF
kunskap $VERSION — knowledge-base plugin

Usage:
  kunskap version | --version
  kunskap help    | --help
  kunskap config user --name <lowercase-slug> [--email <addr>] [--host <host>]
  kunskap config show
  kunskap whoami [--quiet]
  kunskap curate --vault <abs-path> [--check]
  kunskap link-stubs --vault <abs-path> [--format text|json]
  kunskap audit-coverage --vault <abs-path> [--format text|json]

Notes:
  --host is recommended on \`config user\`. Without it, host derives from
  \`hostname -s\` which mutates on machine renames and silently breaks role
  checks at P5. See docs/kunskap-design.md §Q5 (Identity bootstrapping)
  and Risk #5 (Identity fragility).

  \`curate\` spawns the curator agent headlessly via \`claude --plugin-dir\`.
  Requires Claude Code on PATH and Anthropic auth configured.

  \`link-stubs\` and \`audit-coverage\` are pure-shell — no LLM, no auth.
EOF
}

write_identity() {
  local name="$1" email="$2" host="$3"
  mkdir -p "$CONFIG_DIR"
  {
    echo "# kunskap identity — written by \`kunskap config user\`. Edit by hand if needed."
    echo "[user]"
    echo "name  = \"$name\""
    [[ -n "$email" ]] && echo "email = \"$email\""
    echo "host  = \"$host\""
  } > "$IDENTITY_FILE"
}

read_identity_field() {
  local field="$1"
  [[ -f "$IDENTITY_FILE" ]] || return 1
  awk -v f="$field" '
    /^\[user\]/ { in_user = 1; next }
    /^\[/       { in_user = 0; next }
    in_user && $1 == f {
      sub(/^[^=]*=[[:space:]]*"/, "")
      sub(/"[[:space:]]*$/, "")
      print
      exit
    }
  ' "$IDENTITY_FILE"
}

# --name is lowercase-only to pre-empt Paul/paul collisions in the P5
# role-check (identity-string = <name>@<host>); --host stays mixed-case
# because `hostname -s` commonly returns capitalized values.
validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9._-]{0,63}$ ]] \
    || die "--name must match [a-z][a-z0-9._-]{0,63} (lowercase); got: $1"
}
validate_host() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]{1,64}$ ]] \
    || die "--host must match [a-zA-Z0-9._-]{1,64}; got: $1"
}
validate_email() {
  [[ "$1" != *['"'\\$'\n']* ]] \
    || die "--email must not contain quote, backslash, or newline; got: $1"
}

# Validates the value following a flag. Rejects missing, empty, and
# `-`-prefixed values (the last would silently swallow the next flag —
# Pass-2 bug: `--host --email <addr>` parsed host=`--email`).
# Called outside command substitution so `die` exits the script (bash
# quirk: var=$(die …) does NOT propagate exit under set -e).
require_value() {
  local flag="$1" next="$2"
  [[ "$next" != "__MISSING__" ]] || die "$flag requires a value"
  [[ -n "$next" ]]                || die "$flag requires a non-empty value"
  [[ "$next" != -* ]]             || die "$flag requires a value (got next flag: $next)"
}

cmd_config_user() {
  local name="" email="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  require_value --name  "${2-__MISSING__}"; name="$2";  shift 2 ;;
      --email) require_value --email "${2-__MISSING__}"; email="$2"; shift 2 ;;
      --host)  require_value --host  "${2-__MISSING__}"; host="$2";  shift 2 ;;
      *) die "unknown flag for \`config user\`: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "config user: --name <slug> is required"
  validate_name "$name"
  [[ -z "$email" ]] || validate_email "$email"
  [[ -z "$host" ]] || validate_host "$host"

  if [[ -z "$host" ]]; then
    host="$(hostname -s)"
    echo "kunskap: host derived from \`hostname -s\` ($host); explicit --host recommended for stable role-checks (see Risk #5)." >&2
  fi

  write_identity "$name" "$email" "$host"
  echo "kunskap: identity written to $IDENTITY_FILE ($name@$host)"
}

cmd_config_show() {
  [[ $# -eq 0 ]] || die "config show: takes no arguments (got: $*)"
  [[ -f "$IDENTITY_FILE" ]] || die "no identity at $IDENTITY_FILE — run \`kunskap config user --name <slug>\`"
  cat "$IDENTITY_FILE"
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    user) cmd_config_user "$@" ;;
    show) cmd_config_show "$@" ;;
    "")   die "config: subcommand required (user | show)" ;;
    *)    die "config: unknown subcommand: $sub" ;;
  esac
}

cmd_whoami() {
  local quiet=false
  if [[ "${1:-}" == "--quiet" ]]; then
    quiet=true
    shift
  fi
  [[ $# -eq 0 ]] || die "whoami: takes no positional arguments (got: $*)"
  local name host
  if ! name="$(read_identity_field name)" || [[ -z "$name" ]]; then
    $quiet || echo "kunskap: identity not set — run \`kunskap config user --name <slug>\`" >&2
    exit 1
  fi
  if ! host="$(read_identity_field host)" || [[ -z "$host" ]]; then
    $quiet || echo "kunskap: identity missing host — re-run \`kunskap config user\`" >&2
    exit 1
  fi
  $quiet || echo "$name@$host"
}

cmd_curate() {
  local vault="" check=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --check) check=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "curate: --vault <abs-path> is required"
  [[ "$vault" = /* ]] || die "curate: --vault must be an absolute path (got: $vault)"
  [[ ${#extra[@]} -eq 0 ]] || die "curate: unknown extra args: ${extra[*]}"

  validate_vault "$vault"
  $check && { echo "kunskap: vault $vault looks healthy"; return 0; }

  command -v claude >/dev/null || die "curate: \`claude\` not on PATH; install Claude Code first"

  local root prompt
  root="$(plugin_root)"
  prompt="Use the curator agent (from the kunskap plugin) to compile inbox notes for the vault at: $vault

The agent's full system prompt encodes the §Curator contract. Pass the vault path to it as ARGUMENTS so it scopes all writes inside that vault. Do not write outside $vault. Do not modify this plugin repo."

  exec claude --plugin-dir "$root" --permission-mode acceptEdits -p "$prompt"
}

cmd_link_stubs() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "link-stubs: --vault <abs-path> is required"
  [[ "$vault" = /* ]] || die "link-stubs: --vault must be an absolute path (got: $vault)"
  [[ "$format" == "text" || "$format" == "json" ]] || die "link-stubs: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "link-stubs: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) {
        # base name without .md, plus path-relative slug
        n = split(f, parts, "/")
        bn = parts[n]
        sub(/\.md$/, "", bn)
        files[bn] = f
        # also harvest aliases from the file
        while ((getline line < f) > 0) {
          if (line == "---" && !infm) { infm = 1; continue }
          if (line == "---" && infm)  { infm = 0; close(f); break }
          if (infm && line ~ /^aliases:/) {
            sub(/^aliases:[[:space:]]*\[?/, "", line)
            sub(/\]?[[:space:]]*$/, "", line)
            n2 = split(line, al, /,[[:space:]]*/)
            for (i = 1; i <= n2; i++) {
              gsub(/^"|"$|^'\''|'\''$/, "", al[i])
              if (al[i] != "") aliases[al[i]] = bn
            }
          }
        }
        infm = 0
      }
      close(cmd)

      gcmd = "grep -roh \"\\[\\[[^]]*\\]\\]\" \"" vault "/wiki\" 2>/dev/null"
      while ((gcmd | getline link) > 0) {
        gsub(/\[\[|\]\]/, "", link)
        # strip pipe-display ([[link|alt]])
        sub(/\|.*$/, "", link)
        if (link == "") continue
        counts[link]++
      }
      close(gcmd)

      first_resolved = 1; first_alias = 1; first_stub = 1; first_orphan = 1
      if (outfmt == "json") printf "{\n"

      for (link in counts) {
        c = counts[link]
        kebab = link
        gsub(/[[:space:]]+/, "-", kebab)
        kebab = tolower(kebab)
        if (link in files || kebab in files) {
          classify(link, c, "resolved", first_resolved); first_resolved = 0
        } else if (link in aliases) {
          classify(link, c, "alias", first_alias); first_alias = 0
        } else if (c >= 2) {
          classify(link, c, "needs-stub", first_stub); first_stub = 0
        } else {
          classify(link, c, "orphan", first_orphan); first_orphan = 0
        }
      }

      if (outfmt == "json") {
        flush_json("resolved");  flush_json("alias")
        flush_json("needs-stub"); flush_json("orphan")
        printf "\n}\n"
      } else {
        report("needs-stub", "Multi-ref stubs (>=2 refs, no file) — write a concept stub:")
        report("orphan",     "Single-ref orphans (1 ref, no file) — leave as aspirational:")
        report("alias",      "Name-mismatch (resolves via alias) — OK, listed for audit:")
        report("resolved",   "Resolved links — OK:")
      }
    }
    function classify(link, c, kind, _is_first,    rec) {
      rec = link "\t" c
      buckets[kind] = buckets[kind] (buckets[kind] ? "\n" : "") rec
    }
    function flush_json(kind,    n, lines, i, sep, pair) {
      if (! (kind in buckets)) { printf "%s  \"%s\": []", (printed ? ",\n" : ""), kind; printed = 1; return }
      printf "%s  \"%s\": [", (printed ? ",\n" : ""), kind
      n = split(buckets[kind], lines, "\n")
      sep = ""
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        gsub(/\\/, "\\\\", pair[1]); gsub(/"/, "\\\"", pair[1])
        printf "%s\n    {\"link\": \"%s\", \"refs\": %d}", sep, pair[1], pair[2]
        sep = ","
      }
      printf "\n  ]"
      printed = 1
    }
    function report(kind, header,    n, lines, i, pair) {
      print header
      if (! (kind in buckets)) { print "  (none)\n"; return }
      n = split(buckets[kind], lines, "\n")
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        printf "  [%dx] %s\n", pair[2], pair[1]
      }
      print ""
    }
  ' </dev/null
}

cmd_audit_coverage() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "audit-coverage: --vault <abs-path> is required"
  [[ "$vault" = /* ]] || die "audit-coverage: --vault must be an absolute path (got: $vault)"
  [[ "$format" == "text" || "$format" == "json" ]] || die "audit-coverage: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "audit-coverage: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # 1. Collect all source files that exist (inbox + archive).
      collect_sources(vault "/raw/inbox",                "raw/inbox")
      collect_sources(vault "/Archives/processed-inbox", "Archives/processed-inbox")

      # 2. Collect every sources: entry from every wiki article.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) parse_sources(f)
      close(cmd)

      # 3. Compute silent-drops + broken-provenance.
      n_drop = 0; n_broken = 0
      for (s in sources_present)        if (!(s in sources_cited)) drops[++n_drop] = s
      for (s in sources_cited)          if (!(s in sources_present)) broken[++n_broken] = s
      for (s in sources_cited)
        if (s in sources_present)
          covered[++n_cov] = s

      if (outfmt == "json") {
        printf "{\n  \"silent_drops\": ["
        for (i = 1; i <= n_drop; i++) printf "%s\"%s\"", (i>1?", ":""), drops[i]
        printf "],\n  \"broken_provenance\": ["
        for (i = 1; i <= n_broken; i++) printf "%s\"%s\"", (i>1?", ":""), broken[i]
        printf "],\n  \"covered_count\": %d\n}\n", n_cov
      } else {
        printf "Silent drops (file present, no article cites it):\n"
        if (n_drop == 0) print "  (none)"
        for (i = 1; i <= n_drop; i++) printf "  %s\n", drops[i]
        printf "\nBroken provenance (article cites missing file):\n"
        if (n_broken == 0) print "  (none)"
        for (i = 1; i <= n_broken; i++) printf "  %s\n", broken[i]
        printf "\nCovered: %d source files cited by at least one article.\n", n_cov
      }

      # Exit non-zero if any drop or broken provenance.
      if (n_drop > 0 || n_broken > 0) exit 2
    }
    function collect_sources(dir, prefix,    cmd, line, base, rel) {
      cmd = "find \"" dir "\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline line) > 0) {
        base = line
        sub(/.*\//, "", base)
        rel = prefix "/" base
        sources_present[rel] = 1
      }
      close(cmd)
    }
    function parse_sources(f,    line, infm, insrc) {
      infm = 0; insrc = 0
      while ((getline line < f) > 0) {
        if (line == "---") { if (!infm) infm = 1; else { close(f); return }; continue }
        if (!infm) continue
        if (line ~ /^sources:/) { insrc = 1
          # inline form: sources: [a, b]
          if (line ~ /\[/) {
            sub(/^sources:[[:space:]]*\[/, "", line)
            sub(/\][[:space:]]*$/, "", line)
            n = split(line, items, /,[[:space:]]*/)
            for (i = 1; i <= n; i++) {
              gsub(/^[[:space:]"'\'']+|[[:space:]"'\'']+$/, "", items[i])
              if (items[i] != "") sources_cited[items[i]] = 1
            }
            insrc = 0
          }
          continue
        }
        if (insrc) {
          if (line ~ /^[[:space:]]*-[[:space:]]/) {
            entry = line
            sub(/^[[:space:]]*-[[:space:]]*/, "", entry)
            gsub(/^["'\''[:space:]]+|["'\''[:space:]]+$/, "", entry)
            if (entry != "") sources_cited[entry] = 1
          } else if (line ~ /^[^[:space:]]/) {
            # next top-level key — sources block ended
            insrc = 0
          }
        }
      }
      close(f)
    }
  ' </dev/null
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    version|--version)        echo "kunskap $VERSION" ;;
    help|--help|-h)           cmd_help ;;
    config)                   cmd_config "$@" ;;
    whoami)                   cmd_whoami "$@" ;;
    curate)                   cmd_curate "$@" ;;
    link-stubs)               cmd_link_stubs "$@" ;;
    audit-coverage)           cmd_audit_coverage "$@" ;;
    *) die "unknown subcommand: $cmd (try \`kunskap help\`)" ;;
  esac
}

main "$@"
