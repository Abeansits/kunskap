#!/usr/bin/env bash
set -euo pipefail

VERSION="1.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kunskap"
IDENTITY_FILE="$CONFIG_DIR/identity.toml"

GLOBAL_VAULT=""

die() { echo "kunskap: $*" >&2; exit 1; }

plugin_root() {
  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
    return
  fi
  # Resolve symlinks so a ~/bin/kunskap → /opt/kunskap/bin/kunskap shim
  # still finds the plugin's agents/ at /opt/kunskap. macOS BSD readlink
  # has no -f, so walk the chain by hand.
  local src="$0" dir
  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  (cd -P "$(dirname "$src")/.." && pwd)
}

validate_vault() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -d "$vault" ]] || die "vault path not found: $vault"
  [[ -f "$vault/_meta/kunskap.toml" ]] || die "not a kunskap vault (missing _meta/kunskap.toml): $vault"
  [[ -d "$vault/raw/inbox" ]] || die "not a kunskap vault (missing raw/inbox/): $vault"
  [[ -d "$vault/wiki" ]] || die "not a kunskap vault (missing wiki/): $vault"
}

cmd_help() {
  cat <<EOF
kunskap $VERSION — knowledge-base plugin

Usage:
  kunskap version | --version
  kunskap help    | --help
  kunskap config user --name <lowercase-slug> [--email <addr>] [--host <host>]
  kunskap config show
  kunskap [--vault <abs-path>] config get <key>
  kunskap whoami [--quiet]
  kunskap init <path> [--shared <git-remote>] [--name <human-readable>] [--force] [--yes]
  kunskap learn enable --vault <abs-path> [--yes]
  kunskap learn disable
  kunskap learn status
  kunskap curate --vault <abs-path> [--check] [--force] [--yes]
  kunskap lint   [--vault <abs-path>] [--format text|json] [--force] [--yes]
  kunskap drafts list   [--vault <abs-path>] [--format text|json]
  kunskap drafts show   <id-or-slug> [--vault <abs-path>]
  kunskap drafts approve <id-or-slug> [--into <article-slug>] [--vault <abs-path>]
  kunskap drafts reject  <id-or-slug> --reason "<why>" [--vault <abs-path>]
  kunskap drafts defer   <id-or-slug> [--vault <abs-path>]
  kunskap link-stubs --vault <abs-path> [--format text|json]
  kunskap audit-coverage --vault <abs-path> [--format text|json]
  kunskap recall <query> [--vault <abs-path>] [--author <X>] [--tag <Y>] [--limit <N>] [--format text|json]
  kunskap sync   [--vault <abs-path>]

Notes:
  --host is recommended on \`config user\`. Without it, host derives from
  \`hostname -s\` which mutates on machine renames and silently breaks role
  checks at P5. See docs/kunskap-design.md §Q5 (Identity bootstrapping)
  and Risk #5 (Identity fragility).

  \`init\` scaffolds a Kunskap vault at <path>. Without --shared the vault
  is solo (\`shared = false\` in _meta/kunskap.toml; SessionEnd never pushes).
  With --shared <remote>, sets \`shared = true\` and adds origin. Existing
  non-empty target requires --force (and interactive confirm unless --yes
  or KUNSKAP_AUTO_CONFIRM=1; Risk #7 vault-leak prevention).

  \`learn enable\` writes \`.claude/kunskap.json\` in the current project
  pointing at the given vault. Confirmation is required (Risk #7 — vault-leak
  between projects); set KUNSKAP_AUTO_CONFIRM=1 or pass --yes for scripts.

  \`config get <key>\` with --vault reads from <vault>/_meta/kunskap.toml
  (keys: shared, name, created, schema_version); without --vault reads from
  identity.toml (keys: name, email, host). Missing vault config file is
  fail-soft: \`shared\` returns "false", other keys return empty.

  \`curate\` spawns the curator agent headlessly via \`claude --plugin-dir\`.
  Requires Claude Code on PATH and Anthropic auth configured. The CLI
  changes directory into the vault before spawning so the headless agent's
  filesystem sandbox is scoped to the vault (P4 §2 sandbox-CWD bug fix).

  \`lint\` spawns the linter agent the same way. Read-only: the agent only
  writes \`_meta/last-run/linter.json\` (the sole permitted exception,
  recording the run; sharded per-role so curator + linter never race on
  the same file); the CLI verifies all other paths are unchanged post-run.
  Exit codes: 0 = no findings, 1 = findings present (default mode);
  \`--format json\` always exits 0 and emits a structured findings array.
  Vault resolves from --vault, then the project marker (.claude/kunskap.json).

  Both \`curate\` and \`lint\` enforce \`_meta/roles.toml\` (single-primary,
  no fallback — design §Q4): the run refuses if your \`kunskap whoami\`
  identity-string does not match \`roles.<role>.primary\`. \`--force\`
  bypasses the check (interactive confirmation; pass --yes or set
  KUNSKAP_AUTO_CONFIRM=1 to skip the prompt — recorded as forced=true in
  _meta/last-run/<role>.json for audit). Missing roles.toml or primary="TBD"
  warns and proceeds (solo / freshly-init'd vaults must work without
  role config). \`git status --porcelain\` is checked authoritatively.

  \`drafts\` operates on <vault>/wiki/_drafts/. The vault is resolved from
  --vault, then from the project marker (.claude/kunskap.json), then errors.
  approve/reject perform git mv + a single commit; reject requires --reason.

  \`link-stubs\` and \`audit-coverage\` are pure-shell — no LLM, no auth.

  \`sync\` is the manual flush — commits + pushes any uncommitted inbox
  notes immediately. The PostToolUse hook covers most cases asynchronously;
  use \`sync\` for retries (push failed earlier) or to deliberately flush
  before disconnecting. Solo vaults exit 0 with a "not shared" message.
  Identity must be set; rebase-in-progress refuses with an actionable hint.

  \`recall\` searches \`<vault>/wiki/\` and \`<vault>/raw/inbox/\` for the
  query. Stage 1 is \`rg --type md\` (load-bearing). Stage 2 is the Obsidian
  CLI (\`obsidian search\`), only when the desktop app is running AND the
  CLI is enabled (Settings > General > Advanced > Command line interface);
  detection falls back to /Applications/Obsidian.app on macOS. Stage 2
  reranks paths by Obsidian's relevance; if it's unavailable, Stage 1
  carries on its own. Read-only: never writes to the vault. Exit codes:
  0 = at least one hit, 1 = no hits. Vault resolves from --vault, then the
  project marker (.claude/kunskap.json). Identity-independent — works on
  any machine regardless of role.
EOF
}

write_identity() {
  local name="$1" email="$2" host="$3"
  mkdir -p "$CONFIG_DIR"
  {
    echo "# kunskap identity — written by \`kunskap config user\`. Edit by hand if needed."
    echo "[user]"
    echo "name  = \"$name\""
    [[ -n "$email" ]] && echo "email = \"$email\""
    echo "host  = \"$host\""
  } > "$IDENTITY_FILE"
}

# Minimal TOML reader for `<section>.<field>`. Full compliance is P5's job.
read_toml_field() {
  local file="$1" section="$2" field="$3"
  [[ -f "$file" ]] || return 1
  awk -v sec="[$section]" -v f="$field" '
    $0 == sec    { in_sec = 1; next }
    /^\[/        { in_sec = 0; next }
    in_sec && $1 == f {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]*(#.*)?$/, "")
      sub(/^"/, ""); sub(/"$/, "")
      print
      exit
    }
  ' "$file"
}

read_identity_field() {
  read_toml_field "$IDENTITY_FILE" user "$1"
}

# Compute identity-string (`<name>@<host>`) from identity.toml. Echo on stdout;
# return 1 if either field is missing. Used by role-check + last-run record.
compute_identity_string() {
  local name host
  name="$(read_identity_field name)" || return 1
  host="$(read_identity_field host)" || return 1
  [[ -n "$name" && -n "$host" ]] || return 1
  printf '%s@%s\n' "$name" "$host"
}

# Read `roles.<role>.primary` from <vault>/_meta/roles.toml. Echo on stdout
# (empty if file missing or field unset / "TBD"). Treats "TBD" the same as
# missing so the P3 template defaults don't gate runs.
read_role_primary() {
  local vault="$1" role="$2"
  local file="$vault/_meta/roles.toml" val=""
  [[ -f "$file" ]] || return 0
  val="$(read_toml_field "$file" "roles.$role" primary || true)"
  [[ "$val" == "TBD" ]] && val=""
  printf '%s\n' "$val"
}

# Role check: refuse with actionable message unless caller's identity matches
# the primary, or --force is supplied. Missing/TBD primary → warn and proceed.
# Args: <vault> <role> <forced-true-or-false> <yes-true-or-false>
# Returns: 0 to proceed, non-zero die() if the check fails.
check_role() {
  local vault="$1" role="$2" forced="$3" yes="$4"
  local identity primary
  if ! identity="$(compute_identity_string)"; then
    die "$role: identity not set — run \`kunskap config user --name <slug> --host <host>\` first (P1 §5: self-state before external)"
  fi
  primary="$(read_role_primary "$vault" "$role" || true)"
  if [[ -z "$primary" ]]; then
    echo "kunskap: $role: no roles.$role.primary configured ($vault/_meta/roles.toml missing or TBD); running as $identity (warning, not refusal)" >&2
    return 0
  fi
  if [[ "$primary" == "$identity" ]]; then
    return 0
  fi
  if ! $forced; then
    die "$role: $identity is not the primary ($role primary is $primary). Pass --force to override (recorded as forced=true in _meta/last-run/$role.json), or edit $vault/_meta/roles.toml to update primaries. \`kunskap whoami\` shows your identity-string."
  fi
  # Forced: confirm unless --yes (or KUNSKAP_AUTO_CONFIRM=1).
  if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
    {
      printf 'Override role check?\n'
      printf '  ROLE:     %s\n' "$role"
      printf '  PRIMARY:  %s\n' "$primary"
      printf '  CALLER:   %s\n' "$identity"
      printf 'This will be recorded as forced=true in _meta/last-run/%s.json.\nProceed? (y/N) ' "$role"
    } >&2
    local reply=""
    read -r reply || true
    [[ "$reply" =~ ^[Yy]$ ]] || die "$role: cancelled (no run, no record)"
  fi
  echo "kunskap: $role: --force overrides role check ($identity != $primary); recording as forced=true." >&2
  return 0
}

# Count uncommitted inbox notes in a vault. Echoes a bare integer (0 if the
# inbox is clean or the vault isn't a git repo).
count_uncommitted_inbox() {
  local vault="$1"
  [[ -d "$vault/.git" && -d "$vault/raw/inbox" ]] || { echo 0; return; }
  git -C "$vault" status --porcelain -- raw/inbox 2>/dev/null | grep -c . || true
}

# Mid-rebase / merge / cherry-pick guard. Refuse if the vault is in a git
# rewrite (P2 §3 mid-rebase wedge → P4 lint preflight → P5 curate preflight).
mid_rebase_guard() {
  local vault="$1" subcmd="$2"
  if [[ -d "$vault/.git/rebase-merge" || -d "$vault/.git/rebase-apply" \
     || -f "$vault/.git/MERGE_HEAD" || -f "$vault/.git/CHERRY_PICK_HEAD" ]]; then
    die "$subcmd: vault $vault is mid-rebase/merge/cherry-pick; resolve with \`git -C $vault rebase --continue|--abort\` (or \`git merge --abort\`) before $subcmd"
  fi
}

# --name is lowercase-only to pre-empt Paul/paul collisions in the P5
# role-check (identity-string = <name>@<host>); --host stays mixed-case
# because `hostname -s` commonly returns capitalized values.
validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9._-]{0,63}$ ]] \
    || die "--name must match [a-z][a-z0-9._-]{0,63} (lowercase); got: $1"
}
validate_host() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]{1,64}$ ]] \
    || die "--host must match [a-zA-Z0-9._-]{1,64}; got: $1"
}
validate_email() {
  [[ "$1" != *['"'\\$'\n']* ]] \
    || die "--email must not contain quote, backslash, or newline; got: $1"
}

# Validates the value following a flag. Rejects missing, empty, and
# `-`-prefixed values (the last would silently swallow the next flag —
# Pass-2 bug: `--host --email <addr>` parsed host=`--email`).
# Called outside command substitution so `die` exits the script (bash
# quirk: var=$(die …) does NOT propagate exit under set -e).
require_value() {
  local flag="$1" next="$2"
  [[ "$next" != "__MISSING__" ]] || die "$flag requires a value"
  [[ -n "$next" ]]                || die "$flag requires a non-empty value"
  [[ "$next" != -* ]]             || die "$flag requires a value (got next flag: $next)"
}

cmd_config_user() {
  local name="" email="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  require_value --name  "${2-__MISSING__}"; name="$2";  shift 2 ;;
      --email) require_value --email "${2-__MISSING__}"; email="$2"; shift 2 ;;
      --host)  require_value --host  "${2-__MISSING__}"; host="$2";  shift 2 ;;
      *) die "unknown flag for \`config user\`: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "config user: --name <slug> is required"
  validate_name "$name"
  [[ -z "$email" ]] || validate_email "$email"
  [[ -z "$host" ]] || validate_host "$host"

  if [[ -z "$host" ]]; then
    host="$(hostname -s)"
    echo "kunskap: host derived from \`hostname -s\` ($host); explicit --host recommended for stable role-checks (see Risk #5)." >&2
  fi

  write_identity "$name" "$email" "$host"
  echo "kunskap: identity written to $IDENTITY_FILE ($name@$host)"
}

cmd_config_show() {
  [[ $# -eq 0 ]] || die "config show: takes no arguments (got: $*)"
  [[ -f "$IDENTITY_FILE" ]] || die "no identity at $IDENTITY_FILE — run \`kunskap config user --name <slug>\`"
  cat "$IDENTITY_FILE"
}

cmd_config_get() {
  [[ $# -eq 1 ]] || die "config get: takes exactly one <key> argument (got: $*)"
  local key="$1"

  if [[ -n "$GLOBAL_VAULT" ]]; then
    local file="$GLOBAL_VAULT/_meta/kunskap.toml"
    case "$key" in
      shared|name|created|schema_version) ;;
      *) die "config get: unknown vault key: $key (allowed: shared, name, created, schema_version)" ;;
    esac
    if [[ ! -f "$file" ]]; then
      # Fail-soft: P3 ships `kunskap init`, so vaults predate _meta/kunskap.toml.
      # Hooks treat missing-or-unknown as not-shared and skip pull/push.
      [[ "$key" == "shared" ]] && echo "false"
      return 0
    fi
    read_toml_field "$file" vault "$key"
    return 0
  fi

  case "$key" in
    name|email|host) ;;
    *) die "config get: unknown user key: $key (allowed: name, email, host); use --vault for vault keys" ;;
  esac
  [[ -f "$IDENTITY_FILE" ]] || return 0
  read_identity_field "$key"
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    user) cmd_config_user "$@" ;;
    show) cmd_config_show "$@" ;;
    get)  cmd_config_get "$@"  ;;
    "")   die "config: subcommand required (user | show | get)" ;;
    *)    die "config: unknown subcommand: $sub" ;;
  esac
}

cmd_whoami() {
  local quiet=false
  if [[ "${1:-}" == "--quiet" ]]; then
    quiet=true
    shift
  fi
  [[ $# -eq 0 ]] || die "whoami: takes no positional arguments (got: $*)"
  local name host
  if ! name="$(read_identity_field name)" || [[ -z "$name" ]]; then
    $quiet || echo "kunskap: identity not set — run \`kunskap config user --name <slug>\`" >&2
    exit 1
  fi
  if ! host="$(read_identity_field host)" || [[ -z "$host" ]]; then
    $quiet || echo "kunskap: identity missing host — re-run \`kunskap config user\`" >&2
    exit 1
  fi
  $quiet || echo "$name@$host"
}

project_dir() {
  printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

marker_path() {
  printf '%s/.claude/kunskap.json\n' "$(project_dir)"
}

# Looser than validate_vault — `learn enable` may point at a not-yet-init'd
# vault (P3 ships `kunskap init`), so we only require absolute + extant + dir.
validate_vault_loose() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -e "$vault" ]] || die "--vault path does not exist: $vault"
  [[ -d "$vault" ]] || die "--vault path is not a directory: $vault"
}

# ----- CLAUDE.md managed-block injection -----
# `learn enable` injects a managed block; `learn disable` removes it.
# Tamper detection: the block's first line carries a sha256 of the body;
# mismatch on disable refuses rather than silently nuking user edits.

claudemd_path() {
  printf '%s/CLAUDE.md\n' "$(project_dir)"
}

# sha256 of stdin → bare hex on stdout. Portable across BSD shasum (macOS)
# and coreutils sha256sum (Linux); both ship one or the other on the dev
# boxes the plugin targets.
sha256_hex() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    sha256sum | awk '{print $1}'
  fi
}

# Render the body that gets injected between BEGIN/END markers (after the
# hash line). Concatenates templates/LAUNCH_FOOTER.md and the Recall
# addendum. Hashed for tamper detection at disable time.
render_claudemd_body() {
  local template
  template="$(plugin_root)/templates/LAUNCH_FOOTER.md"
  [[ -f "$template" ]] || die "learn enable: missing $template (plugin install incomplete?)"
  cat "$template"
  cat <<'EOF'

## Recall

At task start (before writing code or making a plan), your first action is to run `/kunskap:recall <keywords>` against the goal — pick 2–3 keywords from the user's request — and briefly note the top 1–3 relevant hits before proceeding. If nothing relevant comes back, say "recall: no prior art" and proceed. Skip only when the task is trivial (greetings, time queries, single-line tweaks).
EOF
}

# Echo a path to a temp file containing the full managed block (BEGIN +
# hash line + body + END). Caller cleans up.
render_claudemd_block_file() {
  local body_file block_file hash
  body_file="$(mktemp -t kunskap-body.XXXXXX)"
  block_file="$(mktemp -t kunskap-block.XXXXXX)"
  render_claudemd_body > "$body_file"
  hash="$(sha256_hex < "$body_file")"
  {
    printf '<!-- BEGIN kunskap (managed) -->\n'
    printf '<!-- kunskap:hash %s -->\n' "$hash"
    cat "$body_file"
    printf '<!-- END kunskap (managed) -->\n'
  } > "$block_file"
  rm -f "$body_file"
  printf '%s\n' "$block_file"
}

# Inject (or replace) the managed block in the project's CLAUDE.md.
# Idempotent: a re-enable replaces the existing block in place. Surrounding
# user content is preserved.
inject_claudemd() {
  local file block_file out
  file="$(claudemd_path)"
  block_file="$(render_claudemd_block_file)"
  out="$(mktemp -t kunskap-claudemd.XXXXXX)"

  if [[ -f "$file" ]] && grep -Fq '<!-- BEGIN kunskap (managed) -->' "$file"; then
    # Refuse on garbled markers. Two divergence modes the awk replacement
    # can't survive:
    #   - count != 1: nested BEGIN duplicates the block, missing END drops
    #     all trailing user content (in_block never flips off).
    #   - exact-line count != loose count: marker has leading or trailing
    #     whitespace (or sits inside another line) — grep -F finds it but
    #     awk's `$0 == "..."` won't, leading to a silent non-replacement.
    local n_begin n_end nl_begin nl_end
    n_begin=$(grep -Fxc '<!-- BEGIN kunskap (managed) -->' "$file" 2>/dev/null || echo 0)
    n_end=$(grep -Fxc '<!-- END kunskap (managed) -->' "$file" 2>/dev/null || echo 0)
    nl_begin=$(grep -Fc '<!-- BEGIN kunskap (managed) -->' "$file" 2>/dev/null || echo 0)
    nl_end=$(grep -Fc '<!-- END kunskap (managed) -->' "$file" 2>/dev/null || echo 0)
    if [[ "$n_begin" != "1" || "$n_end" != "1" || "$nl_begin" != "$n_begin" || "$nl_end" != "$n_end" ]]; then
      rm -f "$block_file" "$out"
      die "learn enable: $file has malformed managed-block markers (BEGIN exact=$n_begin loose=$nl_begin, END exact=$n_end loose=$nl_end; expected 1 each as full-line matches with no surrounding whitespace). Repair manually before re-enabling."
    fi
    # Replace block in place. awk swaps the BEGIN/body/END region for the
    # contents of $block_file; surrounding lines pass through untouched.
    awk -v new_block_file="$block_file" '
      $0 == "<!-- BEGIN kunskap (managed) -->" {
        while ((getline line < new_block_file) > 0) print line
        close(new_block_file)
        in_block = 1
        next
      }
      in_block && $0 == "<!-- END kunskap (managed) -->" { in_block = 0; next }
      !in_block { print }
    ' "$file" > "$out"
  elif [[ -f "$file" && -s "$file" ]]; then
    # Append to existing non-empty file with a blank-line separator. Ensure
    # the existing content ends with a newline so the separator is real.
    cp "$file" "$out"
    if [[ -n "$(tail -c1 "$out")" ]]; then printf '\n' >> "$out"; fi
    printf '\n' >> "$out"
    cat "$block_file" >> "$out"
  else
    # No file (or empty file) — fresh write.
    cat "$block_file" > "$out"
  fi

  mkdir -p "$(dirname "$file")"
  mv "$out" "$file"
  rm -f "$block_file"
}

# Remove the managed block from the project's CLAUDE.md. die()s with an
# actionable message if the body inside the fence has been hand-edited
# (sha256 mismatch with the stored hash on the first line of the block).
# Deletes the file entirely if removal leaves only whitespace.
remove_claudemd() {
  local file
  file="$(claudemd_path)"
  [[ -f "$file" ]] || return 0
  if ! grep -Fq '<!-- BEGIN kunskap (managed) -->' "$file"; then
    return 0
  fi

  local block_body
  block_body="$(mktemp -t kunskap-block-body.XXXXXX)"
  awk '
    $0 == "<!-- BEGIN kunskap (managed) -->" { in_block = 1; next }
    $0 == "<!-- END kunskap (managed) -->"   { in_block = 0; next }
    in_block { print }
  ' "$file" > "$block_body"

  local hash_line stored_hash
  hash_line="$(head -n1 "$block_body")"
  local hash_re='^<!-- kunskap:hash ([a-f0-9]{64}) -->$'
  if [[ ! "$hash_line" =~ $hash_re ]]; then
    rm -f "$block_body"
    die "learn disable: managed block in $file lacks fingerprint — manual edits suspected. Remove the block manually before re-enabling."
  fi
  stored_hash="${BASH_REMATCH[1]}"

  local body current_hash
  body="$(mktemp -t kunskap-body-current.XXXXXX)"
  tail -n +2 "$block_body" > "$body"
  current_hash="$(sha256_hex < "$body")"
  rm -f "$block_body" "$body"

  if [[ "$current_hash" != "$stored_hash" ]]; then
    die "learn disable: manual edits detected inside managed block in $file (review before disable)"
  fi

  local out
  out="$(mktemp -t kunskap-claudemd-out.XXXXXX)"
  # Drop the contiguous blank line(s) immediately preceding BEGIN — that's
  # the separator inject_claudemd added when appending. Without this, an
  # enable+disable round-trip leaves an extra blank line at file-end.
  # Trailing blanks AFTER END are preserved (buffered, then flushed on the
  # next non-blank line, dropped at EOF).
  awk '
    $0 == "<!-- BEGIN kunskap (managed) -->" { in_block = 1; blanks = 0; next }
    $0 == "<!-- END kunskap (managed) -->"   { if (in_block) { in_block = 0; next } }
    in_block { next }
    /^$/ { blanks++; next }
    {
      while (blanks-- > 0) print ""
      blanks = 0
      print
    }
  ' "$file" > "$out"

  if grep -q '[^[:space:]]' "$out" 2>/dev/null; then
    mv "$out" "$file"
  else
    rm -f "$out" "$file"
  fi
}

cmd_learn_enable() {
  local vault="" yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --yes|-y) yes=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "learn enable: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "learn enable: unknown extra args: ${extra[*]}"
  validate_vault_loose "$vault"
  # Canonicalize the vault path so the marker stores a physical, normalized
  # absolute path. Without this, multi-slash / `.` segment / symlinked vault
  # paths would defeat the hook's inbox-prefix string match.
  vault="$(cd "$vault" && pwd -P)"

  # Risk #7 (vault-leak between projects) mitigation. The marker file is the
  # privacy primitive — wrong vault = personal notes pushed to the team's
  # research vault, or vice versa. Confirm before writing.
  local proj
  proj="$(project_dir)"

  if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
    # Risk #7 (vault-leak): labeled lines reduce path-noise misreads. Wrong
    # vault here = personal notes pushed to team vault (or vice versa).
    {
      printf 'Enable Kunskap with the following binding?\n'
      printf '  PROJECT: %s\n' "$proj"
      printf '  VAULT:   %s\n' "$vault"
      printf 'Proceed? (y/N) '
    } >&2
    local reply=""
    read -r reply || true
    [[ "$reply" =~ ^[Yy]$ ]] || die "learn enable: cancelled (no marker written)"
  fi

  local marker confirmed_at
  marker="$(marker_path)"
  confirmed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$marker")"
  cat > "$marker" <<EOF
{
  "vault": "$vault",
  "enabled": true,
  "confirmed_at": "$confirmed_at"
}
EOF
  inject_claudemd
  echo "kunskap: enabled in $proj. Vault: $vault. Run \`kunskap learn status\` (or /kunskap:learn status) to verify."
}

cmd_learn_disable() {
  [[ $# -eq 0 ]] || die "learn disable: takes no arguments (got: $*)"
  local proj marker
  proj="$(project_dir)"
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "kunskap: not enabled in $proj (no marker at $marker)"
    return 0
  fi
  remove_claudemd
  rm -f "$marker"
  echo "kunskap: disabled in $proj (removed $marker)"
}

# Pure-shell to bridge GNU/BSD date flag differences.
days_since() {
  local iso="$1" now_epoch then_epoch
  iso="${iso:0:10}"
  [[ "$iso" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "?"; return; }
  now_epoch=$(date -u +%s)
  if then_epoch=$(date -u -j -f "%Y-%m-%d" "$iso" +%s 2>/dev/null); then :
  elif then_epoch=$(date -u -d "$iso" +%s 2>/dev/null); then :
  else echo "?"; return
  fi
  printf '%d\n' "$(( (now_epoch - then_epoch) / 86400 ))"
}

cmd_learn_status() {
  [[ $# -eq 0 ]] || die "learn status: takes no arguments (got: $*)"
  local marker
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "STATUS: disabled (no marker at $marker)"
    return 0
  fi

  local vault enabled confirmed_at
  vault="$(jq -r '.vault // ""' "$marker" 2>/dev/null || true)"
  enabled="$(jq -r '.enabled // false' "$marker" 2>/dev/null || true)"
  confirmed_at="$(jq -r '.confirmed_at // ""' "$marker" 2>/dev/null || true)"

  echo "STATUS: ${enabled:-unknown}"
  echo "VAULT:  ${vault:-<unset>}"

  local identity=""
  if identity="$(compute_identity_string 2>/dev/null)"; then
    echo "IDENTITY: $identity"
  else
    identity=""
    echo "IDENTITY: not set — run \`kunskap config user --name <slug> --host <host>\`"
  fi

  local shared=""
  if [[ -z "$vault" || ! -d "$vault" ]]; then
    echo "SHARED: unknown — vault path missing or unreadable"
  elif [[ ! -f "$vault/_meta/kunskap.toml" ]]; then
    echo "SHARED: unknown — vault not initialized (P3: \`kunskap init\`)"
  else
    shared="$(read_toml_field "$vault/_meta/kunskap.toml" vault shared 2>/dev/null || true)"
    echo "SHARED: ${shared:-unknown}"
  fi

  # Remote health is a top failure mode for shared vaults — surface it so
  # users see "no origin remote" before their first session-end push fails.
  if [[ "$shared" == "true" && -d "$vault/.git" ]]; then
    local remote=""
    remote="$(git -C "$vault" remote get-url origin 2>/dev/null || true)"
    if [[ -n "$remote" ]]; then
      echo "REMOTE: $remote"
    else
      echo "REMOTE: not configured (no \`origin\` remote — pushes will fail)"
    fi
  fi

  # Risk #5 (identity fragility) cross-check: if identity-string appears as a
  # role primary in any roles.toml section, status confirms; mismatch warns.
  local roles_file="$vault/_meta/roles.toml"
  if [[ -n "$identity" && -f "$roles_file" ]]; then
    local cur lin matched=""
    cur="$(read_toml_field "$roles_file" roles.curator primary 2>/dev/null || true)"
    lin="$(read_toml_field "$roles_file" roles.linter  primary 2>/dev/null || true)"
    [[ "$cur" == "$identity" ]] && matched="$matched curator"
    [[ "$lin" == "$identity" ]] && matched="$matched linter"
    if [[ -n "$matched" ]]; then
      echo "ROLE-CHECK: primary for$matched"
    else
      echo "ROLE-CHECK: not primary (curator: ${cur:-<unset>}; linter: ${lin:-<unset>})"
    fi
  elif [[ -n "$identity" ]]; then
    echo "ROLE-CHECK: no roles file (vault not yet initialized — P3/P5)"
  else
    echo "ROLE-CHECK: skipped (identity not set)"
  fi

  if [[ -n "$confirmed_at" ]]; then
    local days
    days="$(days_since "$confirmed_at")"
    if [[ "$days" =~ ^[0-9]+$ ]]; then
      echo "CONFIRMED: $confirmed_at (${days}d ago)"
      # Risk #7 (vault-leak) staleness warning.
      if (( days > 30 )); then
        echo "WARNING: confirmation is >30 days old. Re-run \`kunskap learn enable --vault <path>\` to re-confirm the binding (Risk #7)." >&2
      fi
    else
      echo "CONFIRMED: $confirmed_at (age unparseable)"
    fi
  else
    echo "CONFIRMED: <unset>"
  fi

  # Surface uncommitted inbox notes BEFORE the next session's PostToolUse
  # push hides the backlog.
  if [[ -n "$vault" && -d "$vault/.git" && -d "$vault/raw/inbox" ]]; then
    local pending s=""
    pending=$(count_uncommitted_inbox "$vault")
    if [[ "$pending" -gt 0 ]]; then
      [[ "$pending" != "1" ]] && s="s"
      echo "INBOX: $pending uncommitted note$s — run \`/kunskap:sync\` (or \`kunskap sync\`) to flush"
    else
      echo "INBOX: 0 uncommitted notes"
    fi
  fi
}

cmd_learn() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    enable)  cmd_learn_enable  "$@" ;;
    disable) cmd_learn_disable "$@" ;;
    status)  cmd_learn_status  "$@" ;;
    "")      die "learn: subcommand required (enable | disable | status)" ;;
    *)       die "learn: unknown subcommand: $sub" ;;
  esac
}

cmd_curate() {
  local vault="" check=false force=false yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --check) check=true; shift ;;
      --force) force=true; shift ;;
      --yes|-y) yes=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "curate: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "curate: unknown extra args: ${extra[*]}"
  validate_vault "$vault"
  $check && { echo "kunskap: vault $vault looks healthy"; return 0; }

  # Self-state checks before external (P1 §5). Plugin shape, then vault
  # state (rebase, role), then claude-on-PATH.
  local root
  root="$(plugin_root)"
  [[ -f "$root/agents/curator.md" ]] \
    || die "curate: curator agent not found at $root/agents/curator.md (plugin_root resolved to $root; set CLAUDE_PLUGIN_ROOT to override)"

  mid_rebase_guard "$vault" curate
  check_role "$vault" curator "$force" "$yes"

  command -v claude >/dev/null || die "curate: \`claude\` not on PATH; install Claude Code first"

  local identity head_before forced_json prompt
  identity="$(compute_identity_string)"
  head_before="$(git -C "$vault" rev-parse HEAD 2>/dev/null || echo "")"
  forced_json="false"
  $force && forced_json="true"

  prompt="You have one task: invoke the \`curator\` subagent (defined in this plugin's agents/curator.md) via the Agent tool, passing this exact string as its ARGUMENTS:

$vault

The curator's system prompt encodes the full §Curator contract — it knows what to do once it has the vault path. Do NOT attempt the curation work yourself; the curator subagent must own it. Do not write outside $vault. Do not modify this plugin repo.

After the curator finishes its per-article commit loop, instruct it to write a final \`_meta/last-run/curator.json\` run record (sharded per-role — design §Q4 \"no shared file\" invariant; the linter owns _meta/last-run/linter.json and the curator must NOT touch it). Overwrite — no merge needed since this file is curator-only. The fields it MUST set:
  ran_at: \"<iso-8601 UTC at end of run>\"
  by: \"$identity\"
  inbox_processed: <count of inbox files seen this run>
  articles_written: <count of new+extend wiki articles>
  drafts_routed: <count of drafts written to _drafts/>
  head_before: \"$head_before\"
  head_after: \"<git rev-parse HEAD after the last commit>\"
  forced: $forced_json
Use \`mkdir -p \"\$VAULT/_meta/last-run\"\` then \`jq -n ... > \$VAULT/_meta/last-run/curator.json\`. Final commit message: \`kunskap: curator run record\`.

Report the curator's summary back when it returns."

  # Pass --add-dir explicitly AND cd into the vault before spawning so the
  # headless agent's filesystem sandbox covers the vault (P4 §2 finding —
  # sandbox is CWD-scoped; --plugin-dir + \$ARGUMENTS aren't enough).
  #
  # Permissions: --permission-mode dontAsk + --allowed-tools allow-list
  # (canonical Claude Code docs §Permission modes). acceptEdits
  # auto-approves Edit/Write + filesystem ops (mkdir/mv/cp) but NOT Bash git
  # ops; in headless mode an unmatched git op falls through to the canUseTool
  # callback that doesn't exist, hanging or aborting the run. dontAsk converts
  # any unmatched tool into an explicit denial; the allow-list pre-approves
  # the exact tools the curator agent prompt invokes — no broader.
  #
  # Curator allow-list rationale (each entry maps to a curator-agent op):
  #   Read/Write/Edit/MultiEdit/Glob/Grep — file work + hand-edit detection.
  #   Agent — directive prompt invokes the curator subagent via Agent tool.
  #   Read-only git (status/diff/log/rev-parse/ls-files/check-ignore) — most
  #     are auto-approved as built-in read-only forms of git, but explicit
  #     allow rules insulate against future Claude Code changes + cover the
  #     "unquoted glob promotes to prompt" edge per §Read-only commands.
  #   Write git (add/commit/mv/rm) — MUST 1 atomic per-article commits.
  #   Bare `git foo` form only — Pass-2 empirical finding: `*` in --allowed-
  #     tools matchers is a literal asterisk, not a glob, so a "git -C
  #     <wildcard> foo" rule does not match real `git -C <abs-path> foo`
  #     commands and would be dead weight. We rely on the cd-into-vault
  #     below making CWD = vault so the agent's bare `git foo` form is
  #     sufficient. Verified by smoke: curator's MUST 1 atomic per-article
  #     commits land via bare `git add` + `git commit` + `git mv`.
  #   mkdir/jq/date — `mkdir -p _meta/last-run` + `jq -n ... > curator.json`
  #     + `date -u +...` per the run-record recipe in agents/curator.md §Run
  #     shape step 6.
  #   grep/sort/uniq — stub-discovery pipeline `grep -roh '\[\[' | sort |
  #     uniq -c | sort -rn` per agents/curator.md §Wikilinks. Pipe operators
  #     split into independent subcommands; each needs its own allow rule.
  #   kunskap — preferred alternative `kunskap link-stubs --vault $V --format
  #     json` for the stub-discovery recipe.
  #   No git push, no Bash(*) — push is the SessionEnd hook's job (P2);
  #     Bash(*) would be bypass-equivalent for shell ops.
  local curator_tools="Read,Write,Edit,MultiEdit,Glob,Grep,Agent"
  curator_tools+=",Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(git check-ignore:*)"
  curator_tools+=",Bash(git add:*),Bash(git commit:*),Bash(git mv:*),Bash(git rm:*)"
  curator_tools+=",Bash(mkdir:*),Bash(jq:*),Bash(tee:*),Bash(date:*),Bash(grep:*),Bash(sort:*),Bash(uniq:*),Bash(kunskap:*)"
  cd "$vault"
  exec claude --add-dir "$vault" --plugin-dir "$root" --allowed-tools "$curator_tools" --permission-mode dontAsk -p "$prompt"
}

cmd_lint() {
  local vault_flag="" format="text" force=false yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2";     shift 2 ;;
      --force)  force=true; shift ;;
      --yes|-y) yes=true;   shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ "$format" == "text" || "$format" == "json" ]] || die "lint: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "lint: unknown extra args: ${extra[*]}"

  local vault
  vault="$(resolve_vault_flag_or_marker lint "$vault_flag")"
  validate_vault "$vault"

  # Self-state checks before external (P1 §5). Plugin shape, then vault
  # state (rebase, role), then claude-on-PATH. The rebase guard belongs
  # in self-state because it's a precondition of the invariant check, not
  # a runtime dep.
  local root
  root="$(plugin_root)"
  [[ -f "$root/agents/linter.md" ]] \
    || die "lint: linter agent not found at $root/agents/linter.md (plugin_root resolved to $root; set CLAUDE_PLUGIN_ROOT to override)"

  # Mid-rebase guard fires before role-check + claude-PATH so the user
  # hears about vault wedge state on hosts without claude installed.
  mid_rebase_guard "$vault" lint

  # Role check (P5): linter primary or --force. Missing/TBD primary warns
  # and proceeds (solo / freshly-init'd vault). Identity required either
  # way; whoami unset → fail-closed before claude-PATH.
  check_role "$vault" linter "$force" "$yes"

  command -v claude >/dev/null || die "lint: \`claude\` not on PATH; install Claude Code first"

  # Read-only invariant snapshot — capture BEFORE so a pre-existing dirty
  # vault isn't blamed on the linter (P3 §3 lesson on scaffold-overlay
  # contracts: never gate on a clean state we didn't establish). We snapshot
  # both the working-tree porcelain AND the HEAD oid: porcelain catches
  # untracked/staged/working-tree writes; HEAD catches a write+commit cycle
  # that would leave porcelain clean again (Pass-1 finding).
  local has_git=false status_before head_before
  if git -C "$vault" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    has_git=true
    status_before="$(git -C "$vault" status --porcelain --untracked-files=all 2>/dev/null || true)"
    head_before="$(git -C "$vault" rev-parse HEAD 2>/dev/null || true)"
  fi

  local identity forced_json
  identity="$(compute_identity_string)"
  forced_json="false"
  $force && forced_json="true"

  prompt="You have one task: invoke the \`linter\` subagent (defined in this plugin's agents/linter.md) via the Agent tool, passing this exact string as its ARGUMENTS:

$vault

The linter's system prompt encodes the full read-only audit contract — it knows what to do once it has the vault path. Output format: $format. If the format is \"json\", instruct the linter to emit a single JSON object with a \`findings: [...]\` array of {type, severity, path, message, suggested_action} records (and NO human-readable text). If \"text\", findings are one per line in the shape \`[TYPE] path | message\`, grouped by severity.

After the audit, instruct the linter to record the run by writing \`_meta/last-run/linter.json\` (the SOLE permitted write — sharded per-role, design §Q4; the linter MUST NOT touch _meta/last-run/curator.json), then commit with message \`kunskap: linter run record\`. The fields MUST set:
  ran_at: \"<iso-8601 UTC at end of audit>\"
  by: \"$identity\"
  findings_count: <integer count of findings emitted>
  forced: $forced_json

IMPORTANT — bash redirect workaround: the linter agent's frontmatter disallows the Write/Edit tools (read-only invariant defense in depth), so the run-record write must go through Bash. The headless permission engine does NOT match per-tool rules like \`Bash(jq:*)\` against commands containing \`>\` shell redirection (the redirect operator becomes a separate tool-input field that defeats prefix matching). Use the \`tee\` form instead — \`jq -n ... | tee \$VAULT/_meta/last-run/linter.json\` — which the engine parses as two pipe-split subcommands that each match their own allow-rule. Stdout duplication from \`tee\` is harmless (it goes to the agent's tool result, not the user-facing findings stream).

Do NOT attempt the audit yourself; the linter subagent must own it. Do NOT write any path other than \`_meta/last-run/linter.json\` — the CLI invariant check will fail the run if the linter touches anything else (including _meta/last-run/curator.json). Do not modify this plugin repo. Report the linter's audit output verbatim (the run-record commit is metadata, not part of the findings stdout)."

  # CWD fix (P4 §2): cd into the vault before spawning so the headless
  # agent's filesystem sandbox covers the vault. --add-dir is belt-and-
  # suspenders for the same reason — Claude Code 1.x supports it.
  # Capture exit code WITHOUT `if !` — the negated form sets $? to 0 (the
  # status of `!` itself), losing the real claude failure code (P4 §1).
  #
  # Permissions: same shape as cmd_curate's allow-list, but TIGHTER to
  # reflect the linter's read-only invariant (MUST 8). Differences:
  #   - No Edit/MultiEdit — linter never modifies existing files.
  #   - Write is in the parent allow-list but the linter agent's frontmatter
  #     `disallowedTools: Write, Edit` denies it for the linter subagent
  #     specifically (read-only invariant defense in depth at the agent
  #     contract layer; tests/contract/linter-static-prompt.bats locks this).
  #     The run-record write therefore must go through Bash. The directive
  #     prompt above instructs the agent to use `jq -n ... | tee <path>`
  #     because the headless permission engine does NOT match per-tool rules
  #     like `Bash(jq:*)` against commands with `>` shell redirection — the
  #     redirect operator becomes a separate tool-input field that defeats
  #     prefix matching. The pipe `|` is a documented command
  #     separator, so each subcommand matches its own allow-rule cleanly.
  #     `Bash(tee:*)` below is what makes the recipe work end-to-end.
  #   - The CLI authoritative invariant check (status_before/after + HEAD
  #     oid + log --name-only enumeration, P4 §3) is the trust boundary that
  #     catches any other-path write — the allow-list is defense in depth.
  #   - git mutation rules narrowed: per-path `Bash(git add _meta/last-run/
  #     linter.json)` exact match, plus `Bash(git commit:*)` for the run-
  #     record commit. Per-path `git add` enforces the read-only contract at
  #     the permissions layer too; the broader `git commit:*` is unavoidable
  #     since commit-message shell quoting is fragile to constrain (the CLI
  #     invariant check catches any commit that touches non-whitelisted
  #     paths regardless).
  # Bare `git foo` form only — Pass-2 empirical finding: `*` in --allowed-
  # tools matchers is a literal asterisk, not a glob, so a "git -C <wildcard>
  # foo" rule does not match real `git -C <abs-path> foo` commands and would
  # be dead weight. The cd-into-vault below makes CWD = vault, so the agent's
  # bare `git foo` form covers the linter's MUST 9 run-record commit.
  local linter_tools="Read,Write,Glob,Grep,Agent"
  linter_tools+=",Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git rev-parse:*),Bash(git ls-files:*)"
  linter_tools+=",Bash(git add _meta/last-run/linter.json),Bash(git commit:*)"
  linter_tools+=",Bash(mkdir:*),Bash(jq:*),Bash(tee:*),Bash(date:*),Bash(grep:*),Bash(sort:*),Bash(uniq:*),Bash(kunskap:*)"
  # awk + find + xargs are mandated by agents/linter.md §Frontmatter parsing:
  # the canonical anchor-to-NR==1 awk recipe parses each draft's `created:` /
  # `deferred_at:` for MUST 3 staleness, and `find … | xargs awk` is the
  # single-pass bulk-parsing recipe (agents/linter.md:152). Smoke missed this
  # because the smoke vault had no stale drafts; any production vault with
  # wiki/_drafts/*.md will trigger silent denials without these.
  linter_tools+=",Bash(awk:*),Bash(find:*),Bash(xargs:*)"
  local agent_out agent_status
  if agent_out="$( cd "$vault" && claude --add-dir "$vault" --plugin-dir "$root" --allowed-tools "$linter_tools" --permission-mode dontAsk -p "$prompt" )"; then
    agent_status=0
  else
    agent_status=$?
  fi

  printf '%s\n' "$agent_out"

  # Exit-code priority: invariant violation (2) > agent failure (passthrough)
  # > text-mode findings (1) > clean (0). Invariant fires first because a
  # write is the load-bearing contract failure regardless of agent exit.
  #
  # Whitelist semantics (P5): the linter is permitted to write exactly
  # `_meta/last-run/linter.json` — committed and/or staged — to record its
  # run. The curator owns _meta/last-run/curator.json (sharded per-role —
  # design §Q4 "no shared file" invariant); linter must NOT touch it. Any
  # OTHER touched path (commit content or working tree) is a violation.
  local allowed_path="_meta/last-run/linter.json"
  if $has_git; then
    local status_after head_after
    status_after="$(git -C "$vault" status --porcelain --untracked-files=all 2>/dev/null || true)"
    head_after="$(git -C "$vault" rev-parse HEAD 2>/dev/null || true)"
    if [[ "$status_before" != "$status_after" || "$head_before" != "$head_after" ]]; then
      local violations=()

      if [[ "$head_before" != "$head_after" && -n "$head_before" ]]; then
        local p
        while IFS= read -r p; do
          [[ -z "$p" ]] && continue
          [[ "$p" == "$allowed_path" ]] || violations+=("commit:$p")
        done < <(git -C "$vault" log --name-only --pretty=format: "$head_before..$head_after" 2>/dev/null | sort -u)
      fi

      # Porcelain format is `XY <path>` (3-char status prefix); strip
      # and compare new entries against the whitelist.
      local line p
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        p="${line:3}"
        # Rename: `R  old -> new` — take the new path.
        [[ "$p" == *' -> '* ]] && p="${p##* -> }"
        [[ "$p" == "$allowed_path" ]] || violations+=("porcelain:$p")
      done < <(comm -13 \
                  <(printf '%s\n' "$status_before" | sort) \
                  <(printf '%s\n' "$status_after"  | sort))

      if [[ ${#violations[@]} -gt 0 ]]; then
        {
          echo "kunskap: lint MUST 8 violation — linter wrote outside the whitelist (only \`$allowed_path\` is permitted)."
          echo "  If the curator (or anything else) was running concurrently, that's the diagnostic — re-run \`kunskap lint\` when no other writers are active."
          if [[ "$head_before" != "$head_after" ]]; then
            echo "  HEAD: $head_before → $head_after"
          fi
          echo "  Disallowed paths touched:"
          local v
          for v in "${violations[@]}"; do echo "    $v"; done
        } >&2
        return 2
      fi
    fi
  fi

  [[ "$agent_status" -eq 0 ]] || return "$agent_status"

  # Exit 0 for JSON (the JSON IS the output; downstream parses it).
  # Exit 1 for text mode if any line starts with `[<TYPE>]` (a finding line).
  [[ "$format" == "json" ]] && return 0

  if printf '%s\n' "$agent_out" | grep -Eq '^\[[A-Z-]+\][[:space:]]'; then
    return 1
  fi
  return 0
}

cmd_link_stubs() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "link-stubs: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "link-stubs: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "link-stubs: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # One pass: walk wiki/, harvest filename + aliases from frontmatter and
      # [[wikilinks]] from body in the same read. Frontmatter is the FIRST
      # ---/--- pair only; body --- separators stay body.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) {
        n = split(f, parts, "/")
        bn = parts[n]; sub(/\.md$/, "", bn)
        files[bn] = f
        in_fm = 0; fm_done = 0; ln = 0
        while ((getline line < f) > 0) {
          ln++
          if (!fm_done) {
            if (ln == 1) {
              if (line == "---") { in_fm = 1; continue }
              fm_done = 1
            } else if (in_fm && line == "---") {
              in_fm = 0; fm_done = 1; continue
            }
          }
          if (in_fm && line ~ /^aliases:/) {
            sub(/^aliases:[[:space:]]*\[?/, "", line)
            sub(/\]?[[:space:]]*$/, "", line)
            n2 = split(line, al, /,[[:space:]]*/)
            for (i = 1; i <= n2; i++) {
              gsub(/^"|"$|^'\''|'\''$/, "", al[i])
              if (al[i] != "") aliases[al[i]] = bn
            }
            continue
          }
          if (fm_done) {
            rest = line
            while (match(rest, /\[\[[^]]+\]\]/)) {
              link = substr(rest, RSTART + 2, RLENGTH - 4)
              sub(/\|.*$/, "", link)
              if (link != "") counts[link]++
              rest = substr(rest, RSTART + RLENGTH)
            }
          }
        }
        close(f)
      }
      close(cmd)

      if (outfmt == "json") printf "{\n"

      for (link in counts) {
        c = counts[link]
        kebab = link
        gsub(/[[:space:]]+/, "-", kebab); kebab = tolower(kebab)
        # Resolved: exact filename match OR an existing aliases: entry resolves it.
        # Needs-alias: kebab match exists but the natural-language form is not declared.
        if (link in files || link in aliases)        classify(link, c, "resolved")
        else if (kebab in files)                     classify(link, c, "needs-alias")
        else if (c >= 2)                             classify(link, c, "needs-stub")
        else                                          classify(link, c, "orphan")
      }

      if (outfmt == "json") {
        flush_json("resolved");  flush_json("needs-alias")
        flush_json("needs-stub"); flush_json("orphan")
        printf "\n}\n"
      } else {
        report("needs-stub",  "Multi-ref stubs (>=2 refs, no file) — write a concept stub:")
        report("orphan",      "Single-ref orphans (1 ref, no file) — leave as aspirational:")
        report("needs-alias", "Name-mismatch (kebab matches file, alias not declared) — curator should add aliases:")
        report("resolved",    "Resolved links — OK:")
      }
    }
    function classify(link, c, kind,    rec) {
      rec = link "\t" c
      buckets[kind] = buckets[kind] (buckets[kind] ? "\n" : "") rec
    }
    function flush_json(kind,    n, lines, i, sep, pair) {
      if (! (kind in buckets)) { printf "%s  \"%s\": []", (printed ? ",\n" : ""), kind; printed = 1; return }
      printf "%s  \"%s\": [", (printed ? ",\n" : ""), kind
      n = split(buckets[kind], lines, "\n")
      sep = ""
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        gsub(/\\/, "\\\\", pair[1]); gsub(/"/, "\\\"", pair[1])
        printf "%s\n    {\"link\": \"%s\", \"refs\": %d}", sep, pair[1], pair[2]
        sep = ","
      }
      printf "\n  ]"
      printed = 1
    }
    function report(kind, header,    n, lines, i, pair) {
      print header
      if (! (kind in buckets)) { print "  (none)\n"; return }
      n = split(buckets[kind], lines, "\n")
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        printf "  [%dx] %s\n", pair[2], pair[1]
      }
      print ""
    }
  ' </dev/null
}

cmd_audit_coverage() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "audit-coverage: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "audit-coverage: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "audit-coverage: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # 1. Collect all source files that exist (inbox + archive).
      collect_sources(vault "/raw/inbox",                "raw/inbox")
      collect_sources(vault "/Archives/processed-inbox", "Archives/processed-inbox")

      # 2. Collect every sources: entry from every wiki article.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) parse_sources(f)
      close(cmd)

      # 3. Compute silent-drops + broken-provenance.
      n_drop = 0; n_broken = 0
      for (s in sources_present)        if (!(s in sources_cited)) drops[++n_drop] = s
      for (s in sources_cited)          if (!(s in sources_present)) broken[++n_broken] = s
      for (s in sources_cited)
        if (s in sources_present)
          covered[++n_cov] = s

      if (outfmt == "json") {
        printf "{\n  \"silent_drops\": ["
        for (i = 1; i <= n_drop; i++) printf "%s\"%s\"", (i>1?", ":""), drops[i]
        printf "],\n  \"broken_provenance\": ["
        for (i = 1; i <= n_broken; i++) printf "%s\"%s\"", (i>1?", ":""), broken[i]
        printf "],\n  \"covered_count\": %d\n}\n", n_cov
      } else {
        printf "Silent drops (file present, no article cites it):\n"
        if (n_drop == 0) print "  (none)"
        for (i = 1; i <= n_drop; i++) printf "  %s\n", drops[i]
        printf "\nBroken provenance (article cites missing file):\n"
        if (n_broken == 0) print "  (none)"
        for (i = 1; i <= n_broken; i++) printf "  %s\n", broken[i]
        printf "\nCovered: %d source files cited by at least one article.\n", n_cov
      }

      if (n_drop > 0 || n_broken > 0) exit 2
    }
    function collect_sources(dir, prefix,    cmd, line, base, rel) {
      cmd = "find \"" dir "\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline line) > 0) {
        base = line
        sub(/.*\//, "", base)
        rel = prefix "/" base
        sources_present[rel] = 1
      }
      close(cmd)
    }
    function parse_sources(f,    line, infm, insrc) {
      infm = 0; insrc = 0
      while ((getline line < f) > 0) {
        if (line == "---") { if (!infm) infm = 1; else { close(f); return }; continue }
        if (!infm) continue
        if (line ~ /^sources:/) { insrc = 1
          # inline form: sources: [a, b]
          if (line ~ /\[/) {
            sub(/^sources:[[:space:]]*\[/, "", line)
            sub(/\][[:space:]]*$/, "", line)
            n = split(line, items, /,[[:space:]]*/)
            for (i = 1; i <= n; i++) {
              gsub(/^[[:space:]"'\'']+|[[:space:]"'\'']+$/, "", items[i])
              if (items[i] != "") sources_cited[items[i]] = 1
            }
            insrc = 0
          }
          continue
        }
        if (insrc) {
          if (line ~ /^[[:space:]]*-[[:space:]]/) {
            entry = line
            sub(/^[[:space:]]*-[[:space:]]*/, "", entry)
            gsub(/^["'\''[:space:]]+|["'\''[:space:]]+$/, "", entry)
            if (entry != "") sources_cited[entry] = 1
          } else if (line ~ /^[^[:space:]]/) {
            # next top-level key — sources block ended
            insrc = 0
          }
        }
      }
      close(f)
    }
  ' </dev/null
}

# ---------- init ----------

# Reject substitution inputs that would break the bash literal-substitution
# pass below or escape into shell-eval contexts when echoed back.
validate_template_input() {
  local label="$1" val="$2"
  [[ "$val" != *$'\n'* ]] || die "$label must not contain a newline"
  [[ "$val" != *'"'*   ]] || die "$label must not contain a double-quote"
  [[ "$val" != *\\* ]]    || die "$label must not contain a backslash"
}

substitute_template() {
  local file="$1" name="$2" created="$3" shared="$4"
  [[ -f "$file" ]] || return 0
  local content
  content="$(<"$file")"
  content="${content//\{\{name\}\}/$name}"
  content="${content//\{\{created\}\}/$created}"
  content="${content//\{\{shared\}\}/$shared}"
  printf '%s\n' "$content" > "$file"
}

write_sample_notes() {
  local abs="$1" created="$2"
  cat > "$abs/raw/inbox/example-${created}.md" <<EOF
---
type: learning
session: example
created: ${created}
suggested_topic: example-topic
sources:
  - thread: ~/.claude/projects/example
---

# Example inbox note

This is the shape that sessions write to \`raw/inbox/\`. The curator compiles
notes like this into wiki articles. Replace this file with your own captures
and run \`/kunskap:curate\` to see it process.
EOF

  cat > "$abs/Archives/processed-inbox/example-baseline-${created}.md" <<EOF
---
type: learning
session: example
created: ${created}
suggested_topic: example-topic
sources:
  - thread: ~/.claude/projects/example
---

# Example baseline note

Pre-curated seed. The wiki article at \`wiki/learnings/example-topic.md\`
cites this archived inbox file in its \`## Sources\` footer so
\`kunskap audit-coverage\` passes on a freshly-init'd vault.
EOF

  cat > "$abs/wiki/learnings/example-topic.md" <<EOF
---
type: learning
area: example
tags: [example]
created: ${created}
last_curated: ${created}
source_count: 1
sources:
  - Archives/processed-inbox/example-baseline-${created}.md
aliases: ["example topic"]
author: agent:kunskap-curator
---

# Example topic

This is the shape of a wiki article. The curator writes prose summarizing
inbox notes, with \`[[wikilinks]]\` to other topics and a per-source
\`## Sources\` footer. Replace or extend this with your own articles —
the curator owns this directory.

## Sources

### example-baseline-${created}.md

> Pre-curated seed. The wiki article at wiki/learnings/example-topic.md
> cites this archived inbox file in its ## Sources footer.

Original at Archives/processed-inbox/example-baseline-${created}.md
EOF
}

print_init_next_steps() {
  local abs="$1" shared_remote="$2"
  cat <<EOF
✓ Kunskap vault created: $abs

Next steps:
  cd "$abs"
  git status            # review what was scaffolded
  git add . && git commit -m "kunskap: vault scaffold"

Enable in a project:
  cd <some-project>
  /kunskap:learn enable --vault "$abs"

Roles (P5 will enforce):
  Edit "$abs/_meta/roles.toml" to declare curator + linter primaries
  using your \`kunskap whoami\` identity-string.
EOF
  if [[ -n "$shared_remote" ]]; then
    printf '\nShared remote configured: %s\n' "$shared_remote"
    printf '  After your first commit: git -C "%s" push -u origin main\n' "$abs"
  fi
}

cmd_init() {
  local target="" name="" shared_remote="" force=false yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shared) require_value --shared "${2-__MISSING__}"; shared_remote="$2"; shift 2 ;;
      --name)   require_value --name   "${2-__MISSING__}"; name="$2";          shift 2 ;;
      --force)  force=true; shift ;;
      --yes|-y) yes=true;   shift ;;
      --) shift; while [[ $# -gt 0 ]]; do extra+=("$1"); shift; done ;;
      -*) die "init: unknown flag: $1" ;;
      *)
        if [[ -z "$target" ]]; then target="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$target" ]] || die "init: <path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "init: unknown extra args: ${extra[*]}"

  [[ -n "$name" ]] && validate_template_input "--name" "$name"
  [[ -n "$shared_remote" ]] && validate_template_input "--shared" "$shared_remote"

  # Validate target before requiring git or the template dir, so users see
  # the path-shape error before the dependency-missing one.
  if [[ -e "$target" && ! -d "$target" ]]; then
    die "init: target exists and is not a directory: $target"
  fi
  if [[ -d "$target" && -n "$(ls -A "$target" 2>/dev/null)" ]]; then
    $force || die "init: target $target is non-empty (use --force to scaffold over it)"
    if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
      # Scaffolding over a real project's files would be catastrophic; echo
      # a labeled PATH/ENTRIES summary so a wrong-path mistake is obvious.
      {
        printf 'init: target is non-empty.\n'
        printf '  PATH:    %s\n' "$target"
        printf '  ENTRIES: %s\n' "$(find "$target" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
        printf 'Scaffold over it? (y/N) '
      } >&2
      local reply=""
      read -r reply || true
      [[ "$reply" =~ ^[Yy]$ ]] || die "init: cancelled"
    fi
    # Pass-2 finding: --force --yes used to blindly cp -R the template, which
    # overlaid (and silently overwrote) tracked files like README.md or
    # .gitignore in non-Kunskap repos. Reject when the target carries any
    # template-managed top-level file but is NOT already a Kunskap vault —
    # the marker is `_meta/kunskap.toml` (idempotent re-init still proceeds).
    if [[ ! -f "$target/_meta/kunskap.toml" ]]; then
      local clobbers=()
      for relpath in README.md .gitignore _meta/roles.toml wiki/_index.md; do
        [[ -e "$target/$relpath" ]] && clobbers+=("$relpath")
      done
      if [[ ${#clobbers[@]} -gt 0 ]]; then
        die "init: $target is not a Kunskap vault and contains files the scaffold would overwrite (${clobbers[*]}). Move them aside or pick a different path."
      fi
    fi
  fi

  command -v git >/dev/null || die "init: \`git\` not on PATH; install git first"

  local root tpl
  root="$(plugin_root)"
  tpl="$root/templates/vault-init"
  [[ -d "$tpl" ]] || die "init: template directory not found at $tpl (set CLAUDE_PLUGIN_ROOT to override)"

  mkdir -p "$target"
  local abs
  abs="$(cd "$target" && pwd)"

  cp -R "$tpl/." "$abs/"

  local created shared_value effective_name
  created="$(date -u +%Y-%m-%d)"
  shared_value="false"
  [[ -n "$shared_remote" ]] && shared_value="true"
  effective_name="${name:-$(basename "$abs")}"

  for f in "$abs/_meta/kunskap.toml" "$abs/wiki/_index.md" "$abs/README.md"; do
    substitute_template "$f" "$effective_name" "$created" "$shared_value"
  done

  if [[ ! -d "$abs/.git" ]]; then
    git -C "$abs" init -q
  fi

  if [[ -n "$shared_remote" ]]; then
    if git -C "$abs" remote get-url origin >/dev/null 2>&1; then
      git -C "$abs" remote set-url origin "$shared_remote"
    else
      git -C "$abs" remote add origin "$shared_remote"
    fi
  fi

  write_sample_notes "$abs" "$created"

  print_init_next_steps "$abs" "$shared_remote"
}

# ---------- drafts ----------

# Resolve the vault: --vault wins; otherwise read .claude/kunskap.json from
# CLAUDE_PROJECT_DIR/PWD (matching hooks). Errors when neither resolves.
# Resolve vault path: --vault flag wins, else project marker. Echoes the
# path. Validation is the caller's responsibility (each subcommand has its
# own preconditions — full kunskap vault for lint/recall, drafts dir for
# `drafts`). Label prefixes the diagnostics so the user sees which command
# failed.
resolve_vault_flag_or_marker() {
  local label="$1" explicit="$2"
  if [[ -n "$explicit" ]]; then
    printf '%s\n' "$explicit"
    return 0
  fi
  local marker vault
  marker="$(marker_path)"
  [[ -f "$marker" ]] \
    || die "$label: no --vault and no project marker at $marker; pass --vault <abs> or run \`kunskap learn enable\` first"
  vault="$(jq -r '.vault // ""' "$marker")"
  [[ -n "$vault" ]] || die "$label: marker $marker has no \`vault\` field"
  printf '%s\n' "$vault"
}

resolve_drafts_vault() {
  local explicit="$1" marker vault
  if [[ -n "$explicit" ]]; then
    [[ "$explicit" = /* ]] || die "drafts: --vault must be an absolute path (got: $explicit)"
    [[ -d "$explicit" ]] || die "drafts: vault path not found: $explicit"
    [[ -d "$explicit/wiki/_drafts" ]] || die "drafts: not a kunskap vault (missing wiki/_drafts/): $explicit"
    printf '%s\n' "$explicit"
    return 0
  fi
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    die "drafts: no --vault and no project marker at $marker; pass --vault <abs> or run \`kunskap learn enable\` first"
  fi
  vault="$(jq -r '.vault // ""' "$marker" 2>/dev/null || true)"
  [[ -n "$vault" ]] || die "drafts: marker $marker has no \`vault\` field"
  [[ -d "$vault" ]] || die "drafts: vault $vault from marker does not exist"
  [[ -d "$vault/wiki/_drafts" ]] || die "drafts: $vault is missing wiki/_drafts/ (run \`kunskap init\` to scaffold)"
  printf '%s\n' "$vault"
}

# Walk wiki/_drafts/, parse each file's frontmatter exactly once, and emit
# one TSV record per draft sorted by created date (oldest first):
#   created \t slug \t confidence \t reason \t source_count
# The unparseable-date sort key is "9999-99-99" so missing-date drafts sink
# to the bottom rather than randomizing the listing.
list_draft_records() {
  local vault="$1"
  find "$vault/wiki/_drafts" -mindepth 1 -maxdepth 1 -name '*.md' -not -name '.gitkeep' 2>/dev/null \
    | while IFS= read -r f; do
        awk -v file="$f" '
          BEGIN { fm = 0; insrc = 0; created = ""; conf = ""; reason = ""; n = 0 }
          /^---$/ { fm++; if (fm == 2) { exit } ; next }
          fm != 1 { next }
          /^created:/    { v = $0; sub(/^created:[[:space:]]*/, "", v);    sub(/[[:space:]]*$/, "", v); created = v; next }
          /^confidence:/ { v = $0; sub(/^confidence:[[:space:]]*/, "", v); sub(/[[:space:]]*$/, "", v); conf = v;    next }
          /^reason:/     { v = $0; sub(/^reason:[[:space:]]*/, "", v);     sub(/[[:space:]]*$/, "", v); reason = v;  next }
          /^sources:/ {
            insrc = 1
            if ($0 ~ /\[/) {
              s = $0
              sub(/^sources:[[:space:]]*\[/, "", s)
              sub(/\][[:space:]]*$/, "", s)
              if (s ~ /[^[:space:]]/) {
                k = split(s, items, /,[[:space:]]*/)
                for (i = 1; i <= k; i++) if (items[i] ~ /[^[:space:]]/) n++
              }
              insrc = 0
            }
            next
          }
          insrc && /^[[:space:]]*-[[:space:]]/ { n++; next }
          insrc && /^[^[:space:]]/ { insrc = 0 }
          END {
            slug = file; sub(/.*\//, "", slug); sub(/\.md$/, "", slug)
            sort_key = (created != "" ? created : "9999-99-99")
            printf "%s\t%s\t%s\t%s\t%d\n", sort_key, slug, conf, reason, n
          }
        ' "$f"
      done \
    | sort
}

# Slugs only, in the same order. Used by `resolve_draft_id`.
list_draft_slugs() {
  list_draft_records "$1" | awk -F'\t' '{ print $2 }'
}

resolve_draft_id() {
  local vault="$1" needle="$2"
  [[ -n "$needle" ]] || die "drafts: <id> or <slug> required"
  # macOS ships bash 3.2 which has no `mapfile` — read into the array by hand.
  local slugs=() line
  while IFS= read -r line; do slugs+=("$line"); done < <(list_draft_slugs "$vault")
  local count=${#slugs[@]}
  if [[ "$needle" =~ ^[0-9]+$ ]]; then
    (( needle >= 1 && needle <= count )) || die "drafts: id $needle out of range (have $count)"
    printf '%s/wiki/_drafts/%s.md\n' "$vault" "${slugs[$((needle - 1))]}"
    return 0
  fi
  local match=""
  for s in "${slugs[@]}"; do
    if [[ "$s" == "$needle" ]]; then printf '%s/wiki/_drafts/%s.md\n' "$vault" "$s"; return 0; fi
  done
  for s in "${slugs[@]}"; do
    if [[ "$s" == "$needle"* ]]; then
      [[ -z "$match" ]] || die "drafts: slug prefix \"$needle\" matches multiple drafts"
      match="$s"
    fi
  done
  [[ -n "$match" ]] || die "drafts: no draft matching id-or-slug \"$needle\""
  printf '%s/wiki/_drafts/%s.md\n' "$vault" "$match"
}

cmd_drafts_list() {
  local vault_flag="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2";     shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ "$format" == "text" || "$format" == "json" ]] || die "drafts list: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts list: unknown extra args: ${extra[*]}"
  local vault
  vault="$(resolve_drafts_vault "$vault_flag")"

  local records=() line
  while IFS= read -r line; do records+=("$line"); done < <(list_draft_records "$vault")

  if [[ "$format" == "json" ]]; then
    printf '['
    local sep="" idx=0
    for line in "${records[@]}"; do
      idx=$((idx + 1))
      IFS=$'\t' read -r created slug conf reason srcn <<<"$line"
      local age display_created="$created"
      [[ "$created" == "9999-99-99" ]] && display_created=""
      age="$(days_since "$display_created")"
      conf="${conf//\"/\\\"}"
      reason="${reason//\"/\\\"}"
      printf '%s\n  {"id": %d, "slug": "%s", "confidence": "%s", "reason": "%s", "source_count": %d, "created": "%s", "age_days": "%s"}' \
        "$sep" "$idx" "$slug" "$conf" "$reason" "$srcn" "$display_created" "$age"
      sep=","
    done
    printf '\n]\n'
    return 0
  fi

  if [[ ${#records[@]} -eq 0 ]]; then
    echo "kunskap: no drafts in $vault/wiki/_drafts/"
    return 0
  fi
  echo "kunskap: drafts in $vault/wiki/_drafts/ (oldest first)"
  local idx=0
  for line in "${records[@]}"; do
    idx=$((idx + 1))
    IFS=$'\t' read -r created slug conf _reason srcn <<<"$line"
    local age display_created="$created"
    [[ "$created" == "9999-99-99" ]] && display_created=""
    age="$(days_since "$display_created")"
    printf '  [%d] %s  conf=%s  src=%s  age=%sd\n' "$idx" "$slug" "${conf:-?}" "$srcn" "$age"
  done
}

cmd_drafts_show() {
  local vault_flag="" needle="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts show: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts show: unknown extra args: ${extra[*]}"
  local vault f
  vault="$(resolve_drafts_vault "$vault_flag")"
  f="$(resolve_draft_id "$vault" "$needle")"
  echo "# $(basename "$f" .md)"
  echo "# path: $f"
  echo
  cat "$f"
}

git_commit_drafts_action() {
  local vault="$1" msg="$2"
  [[ -d "$vault/.git" ]] || return 0
  # `git add -A` for the two pathspecs picks up adds, modifies, and deletions.
  # Plain `git add` skips deletions, which would leave _drafts/<slug>.md
  # tracked-but-missing after approve/reject and split the commit in two.
  git -C "$vault" add -A wiki Archives 2>/dev/null || true
  if git -C "$vault" diff --cached --quiet; then return 0; fi
  # Fresh `kunskap init` repos have no committer set; fall back to a kunskap@local
  # identity for the single triage commit rather than blocking on git config.
  if ! git -C "$vault" commit -q -m "$msg" 2>/dev/null; then
    git -C "$vault" -c user.email=kunskap@local -c user.name=kunskap \
       -c commit.gpgsign=false commit -q -m "$msg"
  fi
}

cmd_drafts_approve() {
  local vault_flag="" needle="" into="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --into)  require_value --into  "${2-__MISSING__}"; into="$2";       shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts approve: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts approve: unknown extra args: ${extra[*]}"
  local vault src slug today
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"
  today="$(date -u +%Y-%m-%d)"

  local dest_article archive
  archive="$vault/Archives/processed-drafts/approved/$slug.md"
  mkdir -p "$vault/wiki/learnings" "$vault/Archives/processed-drafts/approved"

  # Privacy / safety: --into <slug> requires the target article to already
  # exist; we never silently create one under the user's nose.
  if [[ -n "$into" ]]; then
    dest_article="$vault/wiki/learnings/${into}.md"
    [[ -f "$dest_article" ]] || die "drafts approve: --into target $dest_article does not exist; create it first or omit --into"
    # Extract body. Frontmatter exists iff line 1 is `---`; in that case the
    # next `---` closes it. Anything else (including subsequent `---` body
    # lines) is body content. Drafts without frontmatter print whole-file.
    # Pass-1 fix: prior `sed -n '/^---$/,/^---$/!p'` lost body content
    # between successive `---` body lines.
    # Pass-2 fix: prior counting awk dropped the entire body when a draft
    # had no frontmatter — only the heading was appended.
    {
      printf '\n### %s — promoted from drafts/%s\n\n' "$today" "$slug"
      awk '
        BEGIN { saw_fm = 0; fm = 0 }
        NR == 1 && /^---$/ { saw_fm = 1; fm = 1; next }
        saw_fm && fm == 1 && /^---$/ { fm = 2; next }
        saw_fm && fm == 1 { next }
        { print }
      ' "$src"
    } >> "$dest_article"
  else
    dest_article="$vault/wiki/learnings/${slug}.md"
    [[ ! -f "$dest_article" ]] || die "drafts approve: $dest_article already exists; pass --into <slug> to merge instead"
    # Strip drafts-only frontmatter fields when promoting to a learnings article.
    awk -v today="$today" '
      BEGIN { fm = 0; in_fm = 0 }
      /^---$/ {
        fm++
        if (fm == 1) { in_fm = 1; print; next }
        if (fm == 2) { print "last_curated: " today; in_fm = 0; print; next }
        print; next
      }
      in_fm {
        if ($0 ~ /^(confidence|reason|deferred_at|approved_at|rejection_reason|lane):/) next
        if ($0 ~ /^type:[[:space:]]*draft[[:space:]]*$/) { print "type: learning"; next }
      }
      { print }
    ' "$src" > "$dest_article"
  fi

  # Archive: we copy the source to the archive (rather than git mv) so the
  # archived form can carry an `approved_at:` stamp that points at the
  # original draft body without disturbing the promoted article's frontmatter.
  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v target="${into:-$slug}" '
    BEGIN { fm = 0 }
    /^---$/ {
      fm++
      print
      if (fm == 1) {
        print "approved_at: " ts
        print "approved_into: " target
      }
      next
    }
    { print }
  ' "$src" > "$archive"
  rm -f "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts approve $slug${into:+ → $into}"
  echo "kunskap: approved $slug → $dest_article"
  echo "         archived original at $archive"
}

cmd_drafts_reject() {
  local vault_flag="" needle="" reason="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --reason) require_value --reason "${2-__MISSING__}"; reason="$2";     shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts reject: <id> or <slug> required"
  [[ -n "$reason" ]] || die "drafts reject: --reason \"<why>\" is required (rejection without reason loses context)"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts reject: unknown extra args: ${extra[*]}"
  validate_template_input "--reason" "$reason"
  local vault src slug archive
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"
  archive="$vault/Archives/processed-drafts/rejected/$slug.md"
  mkdir -p "$vault/Archives/processed-drafts/rejected"
  [[ ! -e "$archive" ]] || die "drafts reject: $archive already exists (slug collision)"

  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v reason="$reason" '
    BEGIN { fm = 0 }
    /^---$/ {
      fm++
      print
      if (fm == 1) {
        print "rejected_at: " ts
        print "rejection_reason: \"" reason "\""
      }
      next
    }
    { print }
  ' "$src" > "$archive"
  rm -f "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts reject $slug — $reason"
  echo "kunskap: rejected $slug → $archive"
}

cmd_drafts_defer() {
  local vault_flag="" needle="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts defer: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts defer: unknown extra args: ${extra[*]}"
  local vault src slug
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"

  local tmp
  tmp="$(mktemp)"
  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    BEGIN { fm = 0; stamped = 0 }
    /^---$/ {
      fm++
      if (fm == 2 && !stamped) { print "deferred_at: " ts; stamped = 1 }
      print
      next
    }
    fm == 1 && /^deferred_at:/ { next }
    { print }
  ' "$src" > "$tmp"
  mv "$tmp" "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts defer $slug"
  echo "kunskap: deferred $slug (stamped deferred_at; left in _drafts/)"
}

cmd_drafts() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list)    cmd_drafts_list    "$@" ;;
    show)    cmd_drafts_show    "$@" ;;
    approve) cmd_drafts_approve "$@" ;;
    reject)  cmd_drafts_reject  "$@" ;;
    defer)   cmd_drafts_defer   "$@" ;;
    *)       die "drafts: unknown subcommand: $sub (try list | show | approve | reject | defer)" ;;
  esac
}

# Output `author<TAB>tags-csv` from frontmatter. Anchored to NR == 1 per
# P3 §1+§2 — sed-range patterns silently corrupt files whose body contains
# horizontal-rule `---`, and an unanchored awk drops frontmatter-less files.
# Suggestion [Refactor] ✨: see `list_draft_records` (line 1207) for the same
# scalar+block-list state machine on a different field set; v1.x candidate
# for a shared `read_frontmatter_fields <file> <scalars> <lists>` helper.
read_recall_frontmatter() {
  local file="$1"
  # YAML accepts both `"..."` and `'...'` for scalars and tag-list items.
  # Strip ONLY matching outer quotes — naive `gsub` of all quotes destroys
  # legitimate apostrophes in values like `O'Reilly` (Codex Pass 2
  # SHOULD-FIX). `\047` is awk's octal escape for `'`.
  awk '
    function strip_outer_quotes(s,    out) {
      out = s
      if (out ~ /^".*"$/)        { sub(/^"/, "", out); sub(/"$/, "", out) }
      else if (out ~ /^\047.*\047$/) {
        sub(/^\047/, "", out); sub(/\047$/, "", out)
        gsub(/\047\047/, "\047", out)   # YAML escape: doubled quote -> one
      }
      return out
    }
    BEGIN { fm = 0; saw_fm = 0; in_tags = 0; author = ""; tags = "" }
    NR == 1 && /^---$/ { saw_fm = 1; fm = 1; next }
    !saw_fm { exit }
    fm == 1 && /^---$/ { exit }
    fm == 1 {
      if (in_tags && /^[[:space:]]+-[[:space:]]+/) {
        v = $0
        sub(/^[[:space:]]+-[[:space:]]+/, "", v)
        sub(/[[:space:]]*$/, "", v)
        v = strip_outer_quotes(v)
        if (v != "") tags = (tags == "" ? v : tags "," v)
        next
      }
      if (in_tags && /^[^[:space:]]/) { in_tags = 0 }

      if (/^author:/) {
        v = $0; sub(/^author:[[:space:]]*/, "", v)
        sub(/[[:space:]]*$/, "", v)
        author = strip_outer_quotes(v); next
      }
      if (/^tags:/) {
        v = $0; sub(/^tags:[[:space:]]*/, "", v)
        sub(/[[:space:]]*$/, "", v)
        if (v ~ /^\[/) {
          sub(/^\[/, "", v); sub(/\][[:space:]]*$/, "", v)
          n = split(v, items, /,[[:space:]]*/)
          for (i = 1; i <= n; i++) {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", items[i])
            items[i] = strip_outer_quotes(items[i])
            if (items[i] != "") tags = (tags == "" ? items[i] : tags "," items[i])
          }
        } else {
          in_tags = 1
        }
        next
      }
    }
    END { printf "%s\t%s\n", author, tags }
  ' "$file"
}

# Stage 1 (rg) is load-bearing per design §Q8 — Stage 2 (Obsidian CLI)
# degrades silently when any check below fails. Returns 1 (no output) when
# unavailable; otherwise echoes the binary path.
detect_obsidian_bin() {
  local bin=""
  if command -v obsidian >/dev/null 2>&1; then
    bin="obsidian"
  elif [[ -x "/Applications/Obsidian.app/Contents/MacOS/obsidian-cli" ]]; then
    bin="/Applications/Obsidian.app/Contents/MacOS/obsidian-cli"
  else
    return 1
  fi
  pgrep -x Obsidian >/dev/null 2>&1 || return 1
  # Smoke via a real `search` probe — it exercises the actual Stage-2 code
  # path. CLI-disabled prints free text ("Command line interface is not
  # enabled..."), enabled prints JSON. Matching JSON validity instead of a
  # specific error string is resilient to Obsidian wording drift (Codex
  # Pass 2 SHOULD-FIX). Probe query is unlikely to match real content.
  ( "$bin" search query="__kunskap_probe__" format=json limit=1 2>/dev/null ) \
    | jq -e 'type' >/dev/null 2>&1 \
    || return 1
  printf '%s\n' "$bin"
}

# Best-effort: returns 1 with no output on any failure; caller falls back to
# rg-only ranking. Per the Obsidian CLI docs, when CWD is a vault folder
# Obsidian uses that vault by default — `cd "$vault"` is the targeting.
# stderr is suppressed on the jq pipe because malformed Obsidian output is a
# documented best-effort degradation, not a bug worth surfacing to users.
run_obsidian_recall() {
  local bin="$1" vault="$2" query="$3"
  ( cd "$vault" && "$bin" search query="$query" format=json 2>/dev/null ) \
    | jq -r 'if type=="array" then .[] | (if type=="object" then (.path // .file // empty) else . end) else empty end' 2>/dev/null \
    || return 1
}

cmd_sync() {
  local vault_flag="$GLOBAL_VAULT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      *) die "sync: unknown arg: $1" ;;
    esac
  done

  local vault
  vault="$(resolve_vault_flag_or_marker sync "$vault_flag")"
  [[ -d "$vault" ]] || die "sync: vault $vault does not exist"

  local who
  who="$(compute_identity_string)" \
    || die "sync: identity not set — run \`kunskap config user --name <slug> --host <host>\`"

  local shared
  shared="$(read_toml_field "$vault/_meta/kunskap.toml" vault shared 2>/dev/null || true)"
  if [[ "$shared" != "true" ]]; then
    echo "kunskap sync: vault is not shared (shared = ${shared:-unset} in $vault/_meta/kunskap.toml). Solo vaults never push."
    return 0
  fi

  mid_rebase_guard "$vault" sync

  cd "$vault" || die "sync: cannot cd to vault $vault"
  git rev-parse --git-dir >/dev/null 2>&1 \
    || die "sync: $vault is not a git repository (run \`kunskap init\` first)"

  git add raw/inbox 2>/dev/null \
    || die "sync: \`git add raw/inbox\` failed (vault not initialized?)"

  if git diff --cached --quiet 2>/dev/null; then
    echo "kunskap sync: nothing to sync (inbox clean)"
    return 0
  fi

  local count
  count=$(git diff --cached --name-only -- raw/inbox/ | grep -c . || true)

  git commit --quiet -m "kunskap: inbox sync (manual, ${who})" \
    || die "sync: commit failed (check \`git status\` in $vault)"

  if ! git push --quiet 2>/dev/null; then
    die "sync: push failed (check remote / network); commit landed locally and will retry on next sync"
  fi

  local s=""
  [[ "$count" != "1" ]] && s="s"
  echo "kunskap sync: synced ${count} note${s} (committed + pushed)"
}

cmd_recall() {
  local vault_flag="$GLOBAL_VAULT" author="" tag="" limit=20 format="text"
  local query_tokens=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --author) require_value --author "${2-__MISSING__}"; author="$2";     shift 2 ;;
      --tag)    require_value --tag    "${2-__MISSING__}"; tag="$2";        shift 2 ;;
      --limit)  require_value --limit  "${2-__MISSING__}"; limit="$2";      shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2";     shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do query_tokens+=("$1"); shift; done ;;
      -*) die "recall: unknown flag: $1" ;;
      *)  query_tokens+=("$1"); shift ;;
    esac
  done
  # Multi-word queries: `kunskap recall machine learning` joins to "machine
  # learning" — researchers naturally type unquoted phrases (Codex Pass 2
  # SHOULD-FIX). Single-token queries pass through unchanged.
  [[ ${#query_tokens[@]} -gt 0 ]] \
    || die "recall: missing <query> (usage: kunskap recall <query> [--author X] [--tag Y] [--limit N] [--format text|json])"
  local query="${query_tokens[*]}"
  [[ "$format" == "text" || "$format" == "json" ]] || die "recall: --format must be text or json (got: $format)"
  [[ "$limit" =~ ^[0-9]+$ && "$limit" -gt 0 ]] \
    || die "recall: --limit must be a positive integer (got: $limit)"

  local vault
  vault="$(resolve_vault_flag_or_marker recall "$vault_flag")"
  validate_vault "$vault"

  # Self-state before external (P1 §5): vault error is actionable without
  # the tooling.
  command -v rg >/dev/null \
    || die "recall: \`rg\` not on PATH; install ripgrep first (\`brew install ripgrep\` or apt-get install ripgrep)"
  command -v jq >/dev/null \
    || die "recall: \`jq\` not on PATH; install jq first"

  # --fixed-strings keeps queries literal (so `kunskap recall "two-pass"`
  # isn't parsed as a regex). rg's exit codes: 0 = matches found, 1 = no
  # matches, 2+ = real failure (path unreadable, glob error, etc). Tolerate
  # 1, surface 2+ — the silent `|| true` form would mask permission errors
  # as "no hits" and erode user trust in Stage 1 (Codex Pass 1 BLOCK-SHIP).
  local rg_raw rg_status=0
  if rg_raw="$(rg --json --type md --fixed-strings --no-messages -- "$query" \
                  "$vault/wiki" "$vault/raw/inbox" 2>/dev/null)"; then
    rg_status=0
  else
    rg_status=$?
  fi
  [[ "$rg_status" -le 1 ]] \
    || die "recall: rg failed with status $rg_status (check vault paths and read permissions on $vault/wiki and $vault/raw/inbox)"

  local rg_hits
  rg_hits="$(
    printf '%s\n' "$rg_raw" \
      | jq -c --arg prefix "$vault/" '
          select(.type == "match")
          | {
              path: (
                if (.data.path.text | startswith($prefix))
                then .data.path.text[$prefix|length:]
                else .data.path.text
                end
              ),
              line: .data.line_number,
              snippet: (.data.lines.text | sub("\n$"; ""))
            }
        '
  )"

  # Per-file frontmatter (bash 3.2 has no assoc arrays — emit JSONL, jq
  # joins below). One awk fork per unique path.
  local fm_jsonl
  fm_jsonl="$(
    printf '%s\n' "$rg_hits" | jq -r 'select(. != null) | .path' | sort -u \
      | while IFS= read -r p; do
          [[ -z "$p" ]] && continue
          local meta a t
          meta="$(read_recall_frontmatter "$vault/$p")"
          a="${meta%%	*}"
          t="${meta#*	}"
          jq -nc --arg path "$p" --arg author "$a" --arg tags "$t" '
            {
              path: $path,
              author: (if $author == "" then null else $author end),
              tags:   (if $tags   == "" then []   else ($tags | split(",")) end)
            }
          '
        done
  )"

  # Stage 2: Obsidian relevance ranks (best-effort).
  local obs_jsonl="" obs_used=false
  local obs_bin obs_paths
  if obs_bin="$(detect_obsidian_bin)"; then
    if obs_paths="$(run_obsidian_recall "$obs_bin" "$vault" "$query")"; then
      obs_used=true
      obs_jsonl="$(
        idx=0
        while IFS= read -r p; do
          [[ -z "$p" ]] && continue
          # Normalize Obsidian path to vault-relative POSIX (Codex Pass 2):
          # strip absolute vault prefix, leading "./", convert backslashes.
          # Without this, the join with rg paths in $omap silently drops
          # under platform path-shape mismatch.
          [[ "$p" == "$vault/"* ]] && p="${p#"$vault/"}"
          [[ "$p" == ./* ]] && p="${p#./}"
          p="${p//\\//}"
          jq -nc --arg path "$p" --argjson rank "$idx" '{path: $path, obs_rank: $rank}'
          idx=$((idx + 1))
        done <<< "$obs_paths"
      )"
    fi
  fi

  local fm_array obs_array
  if [[ -n "$fm_jsonl" ]];  then fm_array="$(printf  '%s' "$fm_jsonl"  | jq -cs '.')"; else fm_array='[]';  fi
  if [[ -n "$obs_jsonl" ]]; then obs_array="$(printf '%s' "$obs_jsonl" | jq -cs '.')"; else obs_array='[]'; fi
  local hits_json
  hits_json="$(
    printf '%s\n' "$rg_hits" \
      | jq -s \
          --argjson limit "$limit" \
          --argjson obs_used "$obs_used" \
          --arg author_filter "$author" \
          --arg tag_filter "$tag" \
          --argjson fm  "$fm_array" \
          --argjson obs "$obs_array" '
          ($fm  | map({(.path): {author, tags}})  | add // {}) as $fmap |
          ($obs | map({(.path): .obs_rank})       | add // {}) as $omap |
          (group_by(.path) | map({(.[0].path): length}) | add // {}) as $score |
          map(
            . as $hit
            | (.path) as $p
            | . + {
                author: ($fmap[$p].author // null),
                tags:   ($fmap[$p].tags   // []),
                obs_rank: ($omap[$p] // null),
                score: ($score[$p] // 0)
              }
          )
          | map(
              select(
                ($author_filter == "" or .author == $author_filter)
                and ($tag_filter == ""  or (.tags | index($tag_filter)) != null)
              )
            )
          | sort_by(
              (if $obs_used and .obs_rank != null then 0 else 1 end),
              (.obs_rank // 99999),
              (-.score),
              .path,
              .line
            )
          | .[:$limit]
        '
  )"

  local hit_count
  hit_count="$(printf '%s' "$hits_json" | jq 'length')"

  if [[ "$format" == "json" ]]; then
    printf '%s\n' "$hits_json" | jq '{hits: .}'
  elif [[ "$hit_count" -eq 0 ]]; then
    echo "kunskap: no hits for \"$query\" in $vault"
  else
    printf '%s\n' "$hits_json" | jq -r '
      .[]
      | "- \(.path):\(.line) (score \(.score)\(if .obs_rank != null then ", obs#\(.obs_rank+1)" else "" end))"
        + (if (.tags|length) > 0 then " [\(.tags | join(", "))]" else "" end)
        + "\n    \(.snippet | gsub("^\\s+|\\s+$"; ""))"
    '
  fi

  [[ "$hit_count" -gt 0 ]] || return 1
  return 0
}

main() {
  # Pre-dispatch globals are consumed only when they precede the first
  # non-flag token; subcommand-local `--vault` (curate, learn enable) is
  # still parsed inside the subcommand.
  while [[ $# -gt 0 && "$1" == --vault ]]; do
    require_value --vault "${2-__MISSING__}"
    GLOBAL_VAULT="$2"
    shift 2
  done

  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    version|--version)        echo "kunskap $VERSION" ;;
    help|--help|-h)           cmd_help ;;
    init)                     cmd_init "$@" ;;
    config)                   cmd_config "$@" ;;
    whoami)                   cmd_whoami "$@" ;;
    learn)                    cmd_learn "$@" ;;
    curate)                   cmd_curate "$@" ;;
    lint)                     cmd_lint "$@" ;;
    drafts)                   cmd_drafts "$@" ;;
    link-stubs)               cmd_link_stubs "$@" ;;
    audit-coverage)           cmd_audit_coverage "$@" ;;
    recall)                   cmd_recall "$@" ;;
    sync)                     cmd_sync "$@" ;;
    *) die "unknown subcommand: $cmd (try \`kunskap help\`)" ;;
  esac
}

main "$@"
