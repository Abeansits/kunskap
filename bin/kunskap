#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kunskap"
IDENTITY_FILE="$CONFIG_DIR/identity.toml"

GLOBAL_VAULT=""

die() { echo "kunskap: $*" >&2; exit 1; }

plugin_root() {
  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
    printf '%s\n' "$CLAUDE_PLUGIN_ROOT"
    return
  fi
  # Resolve symlinks so a ~/bin/kunskap → /opt/kunskap/bin/kunskap shim
  # still finds the plugin's agents/ at /opt/kunskap. macOS BSD readlink
  # has no -f, so walk the chain by hand.
  local src="$0" dir
  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  (cd -P "$(dirname "$src")/.." && pwd)
}

validate_vault() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -d "$vault" ]] || die "vault path not found: $vault"
  [[ -f "$vault/_meta/kunskap.toml" ]] || die "not a kunskap vault (missing _meta/kunskap.toml): $vault"
  [[ -d "$vault/raw/inbox" ]] || die "not a kunskap vault (missing raw/inbox/): $vault"
}

cmd_help() {
  cat <<EOF
kunskap $VERSION — knowledge-base plugin

Usage:
  kunskap version | --version
  kunskap help    | --help
  kunskap config user --name <lowercase-slug> [--email <addr>] [--host <host>]
  kunskap config show
  kunskap [--vault <abs-path>] config get <key>
  kunskap whoami [--quiet]
  kunskap init <path> [--shared <git-remote>] [--name <human-readable>] [--force] [--yes]
  kunskap learn enable --vault <abs-path> [--yes]
  kunskap learn disable
  kunskap learn status
  kunskap curate --vault <abs-path> [--check]
  kunskap drafts list   [--vault <abs-path>] [--format text|json]
  kunskap drafts show   <id-or-slug> [--vault <abs-path>]
  kunskap drafts approve <id-or-slug> [--into <article-slug>] [--vault <abs-path>] [--yes]
  kunskap drafts reject  <id-or-slug> --reason "<why>" [--vault <abs-path>] [--yes]
  kunskap drafts defer   <id-or-slug> [--vault <abs-path>]
  kunskap link-stubs --vault <abs-path> [--format text|json]
  kunskap audit-coverage --vault <abs-path> [--format text|json]

Notes:
  --host is recommended on \`config user\`. Without it, host derives from
  \`hostname -s\` which mutates on machine renames and silently breaks role
  checks at P5. See docs/kunskap-design.md §Q5 (Identity bootstrapping)
  and Risk #5 (Identity fragility).

  \`init\` scaffolds a Kunskap vault at <path>. Without --shared the vault
  is solo (\`shared = false\` in _meta/kunskap.toml; SessionEnd never pushes).
  With --shared <remote>, sets \`shared = true\` and adds origin. Existing
  non-empty target requires --force (and interactive confirm unless --yes
  or KUNSKAP_AUTO_CONFIRM=1; Risk #7 vault-leak prevention).

  \`learn enable\` writes \`.claude/kunskap.json\` in the current project
  pointing at the given vault. Confirmation is required (Risk #7 — vault-leak
  between projects); set KUNSKAP_AUTO_CONFIRM=1 or pass --yes for scripts.

  \`config get <key>\` with --vault reads from <vault>/_meta/kunskap.toml
  (keys: shared, name, created, schema_version); without --vault reads from
  identity.toml (keys: name, email, host). Missing vault config file is
  fail-soft: \`shared\` returns "false", other keys return empty.

  \`curate\` spawns the curator agent headlessly via \`claude --plugin-dir\`.
  Requires Claude Code on PATH and Anthropic auth configured.

  \`drafts\` operates on <vault>/wiki/_drafts/. The vault is resolved from
  --vault, then from the project marker (.claude/kunskap.json), then errors.
  approve/reject perform git mv + a single commit; reject requires --reason.

  \`link-stubs\` and \`audit-coverage\` are pure-shell — no LLM, no auth.
EOF
}

write_identity() {
  local name="$1" email="$2" host="$3"
  mkdir -p "$CONFIG_DIR"
  {
    echo "# kunskap identity — written by \`kunskap config user\`. Edit by hand if needed."
    echo "[user]"
    echo "name  = \"$name\""
    [[ -n "$email" ]] && echo "email = \"$email\""
    echo "host  = \"$host\""
  } > "$IDENTITY_FILE"
}

# Minimal TOML reader for `<section>.<field>`. Full compliance is P5's job.
read_toml_field() {
  local file="$1" section="$2" field="$3"
  [[ -f "$file" ]] || return 1
  awk -v sec="[$section]" -v f="$field" '
    $0 == sec    { in_sec = 1; next }
    /^\[/        { in_sec = 0; next }
    in_sec && $1 == f {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]]*(#.*)?$/, "")
      sub(/^"/, ""); sub(/"$/, "")
      print
      exit
    }
  ' "$file"
}

read_identity_field() {
  read_toml_field "$IDENTITY_FILE" user "$1"
}

# --name is lowercase-only to pre-empt Paul/paul collisions in the P5
# role-check (identity-string = <name>@<host>); --host stays mixed-case
# because `hostname -s` commonly returns capitalized values.
validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9._-]{0,63}$ ]] \
    || die "--name must match [a-z][a-z0-9._-]{0,63} (lowercase); got: $1"
}
validate_host() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]{1,64}$ ]] \
    || die "--host must match [a-zA-Z0-9._-]{1,64}; got: $1"
}
validate_email() {
  [[ "$1" != *['"'\\$'\n']* ]] \
    || die "--email must not contain quote, backslash, or newline; got: $1"
}

# Validates the value following a flag. Rejects missing, empty, and
# `-`-prefixed values (the last would silently swallow the next flag —
# Pass-2 bug: `--host --email <addr>` parsed host=`--email`).
# Called outside command substitution so `die` exits the script (bash
# quirk: var=$(die …) does NOT propagate exit under set -e).
require_value() {
  local flag="$1" next="$2"
  [[ "$next" != "__MISSING__" ]] || die "$flag requires a value"
  [[ -n "$next" ]]                || die "$flag requires a non-empty value"
  [[ "$next" != -* ]]             || die "$flag requires a value (got next flag: $next)"
}

cmd_config_user() {
  local name="" email="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  require_value --name  "${2-__MISSING__}"; name="$2";  shift 2 ;;
      --email) require_value --email "${2-__MISSING__}"; email="$2"; shift 2 ;;
      --host)  require_value --host  "${2-__MISSING__}"; host="$2";  shift 2 ;;
      *) die "unknown flag for \`config user\`: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "config user: --name <slug> is required"
  validate_name "$name"
  [[ -z "$email" ]] || validate_email "$email"
  [[ -z "$host" ]] || validate_host "$host"

  if [[ -z "$host" ]]; then
    host="$(hostname -s)"
    echo "kunskap: host derived from \`hostname -s\` ($host); explicit --host recommended for stable role-checks (see Risk #5)." >&2
  fi

  write_identity "$name" "$email" "$host"
  echo "kunskap: identity written to $IDENTITY_FILE ($name@$host)"
}

cmd_config_show() {
  [[ $# -eq 0 ]] || die "config show: takes no arguments (got: $*)"
  [[ -f "$IDENTITY_FILE" ]] || die "no identity at $IDENTITY_FILE — run \`kunskap config user --name <slug>\`"
  cat "$IDENTITY_FILE"
}

cmd_config_get() {
  [[ $# -eq 1 ]] || die "config get: takes exactly one <key> argument (got: $*)"
  local key="$1"

  if [[ -n "$GLOBAL_VAULT" ]]; then
    local file="$GLOBAL_VAULT/_meta/kunskap.toml"
    case "$key" in
      shared|name|created|schema_version) ;;
      *) die "config get: unknown vault key: $key (allowed: shared, name, created, schema_version)" ;;
    esac
    if [[ ! -f "$file" ]]; then
      # Fail-soft: P3 ships `kunskap init`, so vaults predate _meta/kunskap.toml.
      # Hooks treat missing-or-unknown as not-shared and skip pull/push.
      [[ "$key" == "shared" ]] && echo "false"
      return 0
    fi
    read_toml_field "$file" vault "$key"
    return 0
  fi

  case "$key" in
    name|email|host) ;;
    *) die "config get: unknown user key: $key (allowed: name, email, host); use --vault for vault keys" ;;
  esac
  [[ -f "$IDENTITY_FILE" ]] || return 0
  read_identity_field "$key"
}

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    user) cmd_config_user "$@" ;;
    show) cmd_config_show "$@" ;;
    get)  cmd_config_get "$@"  ;;
    "")   die "config: subcommand required (user | show | get)" ;;
    *)    die "config: unknown subcommand: $sub" ;;
  esac
}

cmd_whoami() {
  local quiet=false
  if [[ "${1:-}" == "--quiet" ]]; then
    quiet=true
    shift
  fi
  [[ $# -eq 0 ]] || die "whoami: takes no positional arguments (got: $*)"
  local name host
  if ! name="$(read_identity_field name)" || [[ -z "$name" ]]; then
    $quiet || echo "kunskap: identity not set — run \`kunskap config user --name <slug>\`" >&2
    exit 1
  fi
  if ! host="$(read_identity_field host)" || [[ -z "$host" ]]; then
    $quiet || echo "kunskap: identity missing host — re-run \`kunskap config user\`" >&2
    exit 1
  fi
  $quiet || echo "$name@$host"
}

project_dir() {
  printf '%s\n' "${CLAUDE_PROJECT_DIR:-$PWD}"
}

marker_path() {
  printf '%s/.claude/kunskap.json\n' "$(project_dir)"
}

# Looser than validate_vault — `learn enable` may point at a not-yet-init'd
# vault (P3 ships `kunskap init`), so we only require absolute + extant + dir.
validate_vault_loose() {
  local vault="$1"
  [[ "$vault" = /* ]] || die "--vault must be an absolute path (got: $vault)"
  [[ -e "$vault" ]] || die "--vault path does not exist: $vault"
  [[ -d "$vault" ]] || die "--vault path is not a directory: $vault"
}

cmd_learn_enable() {
  local vault="" yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --yes|-y) yes=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "learn enable: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "learn enable: unknown extra args: ${extra[*]}"
  validate_vault_loose "$vault"

  # Risk #7 (vault-leak between projects) mitigation. The marker file is the
  # privacy primitive — wrong vault = personal notes pushed to the team's
  # research vault, or vice versa. Confirm before writing.
  local proj
  proj="$(project_dir)"

  if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
    # Risk #7 (vault-leak): labeled lines reduce path-noise misreads. Wrong
    # vault here = personal notes pushed to team vault (or vice versa).
    {
      printf 'Enable Kunskap with the following binding?\n'
      printf '  PROJECT: %s\n' "$proj"
      printf '  VAULT:   %s\n' "$vault"
      printf 'Proceed? (y/N) '
    } >&2
    local reply=""
    read -r reply || true
    [[ "$reply" =~ ^[Yy]$ ]] || die "learn enable: cancelled (no marker written)"
  fi

  local marker confirmed_at
  marker="$(marker_path)"
  confirmed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$(dirname "$marker")"
  cat > "$marker" <<EOF
{
  "vault": "$vault",
  "enabled": true,
  "confirmed_at": "$confirmed_at"
}
EOF
  echo "kunskap: enabled in $proj. Vault: $vault. Run \`kunskap learn status\` (or /kunskap:learn status) to verify."
}

cmd_learn_disable() {
  [[ $# -eq 0 ]] || die "learn disable: takes no arguments (got: $*)"
  local proj marker
  proj="$(project_dir)"
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "kunskap: not enabled in $proj (no marker at $marker)"
    return 0
  fi
  rm -f "$marker"
  echo "kunskap: disabled in $proj (removed $marker)"
}

# Pure-shell to bridge GNU/BSD date flag differences.
days_since() {
  local iso="$1" now_epoch then_epoch
  iso="${iso:0:10}"
  [[ "$iso" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "?"; return; }
  now_epoch=$(date -u +%s)
  if then_epoch=$(date -u -j -f "%Y-%m-%d" "$iso" +%s 2>/dev/null); then :
  elif then_epoch=$(date -u -d "$iso" +%s 2>/dev/null); then :
  else echo "?"; return
  fi
  printf '%d\n' "$(( (now_epoch - then_epoch) / 86400 ))"
}

cmd_learn_status() {
  [[ $# -eq 0 ]] || die "learn status: takes no arguments (got: $*)"
  local marker
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    echo "STATUS: disabled (no marker at $marker)"
    return 0
  fi

  local vault enabled confirmed_at
  vault="$(jq -r '.vault // ""' "$marker" 2>/dev/null || true)"
  enabled="$(jq -r '.enabled // false' "$marker" 2>/dev/null || true)"
  confirmed_at="$(jq -r '.confirmed_at // ""' "$marker" 2>/dev/null || true)"

  echo "STATUS: ${enabled:-unknown}"
  echo "VAULT:  ${vault:-<unset>}"

  local identity name host
  if name="$(read_identity_field name 2>/dev/null)" && [[ -n "$name" ]] \
     && host="$(read_identity_field host 2>/dev/null)" && [[ -n "$host" ]]; then
    identity="$name@$host"
    echo "IDENTITY: $identity"
  else
    identity=""
    echo "IDENTITY: not set — run \`kunskap config user --name <slug> --host <host>\`"
  fi

  local shared=""
  if [[ -z "$vault" || ! -d "$vault" ]]; then
    echo "SHARED: unknown — vault path missing or unreadable"
  elif [[ ! -f "$vault/_meta/kunskap.toml" ]]; then
    echo "SHARED: unknown — vault not initialized (P3: \`kunskap init\`)"
  else
    shared="$(read_toml_field "$vault/_meta/kunskap.toml" vault shared 2>/dev/null || true)"
    echo "SHARED: ${shared:-unknown}"
  fi

  # Remote health is a top failure mode for shared vaults — surface it so
  # users see "no origin remote" before their first session-end push fails.
  if [[ "$shared" == "true" && -d "$vault/.git" ]]; then
    local remote=""
    remote="$(git -C "$vault" remote get-url origin 2>/dev/null || true)"
    if [[ -n "$remote" ]]; then
      echo "REMOTE: $remote"
    else
      echo "REMOTE: not configured (no \`origin\` remote — pushes will fail)"
    fi
  fi

  # Risk #5 (identity fragility) cross-check: if identity-string appears as a
  # role primary in any roles.toml section, status confirms; mismatch warns.
  local roles_file="$vault/_meta/roles.toml"
  if [[ -n "$identity" && -f "$roles_file" ]]; then
    local matched=""
    for role in curator linter; do
      local primary
      primary="$(read_toml_field "$roles_file" "roles.$role" primary 2>/dev/null || true)"
      [[ "$primary" == "$identity" ]] && matched="$matched $role"
    done
    if [[ -n "$matched" ]]; then
      echo "ROLE-CHECK: primary for$matched"
    else
      local cur lin
      cur="$(read_toml_field "$roles_file" roles.curator primary 2>/dev/null || true)"
      lin="$(read_toml_field "$roles_file" roles.linter  primary 2>/dev/null || true)"
      echo "ROLE-CHECK: not primary (curator: ${cur:-<unset>}; linter: ${lin:-<unset>})"
    fi
  elif [[ -n "$identity" ]]; then
    echo "ROLE-CHECK: no roles file (vault not yet initialized — P3/P5)"
  else
    echo "ROLE-CHECK: skipped (identity not set)"
  fi

  if [[ -n "$confirmed_at" ]]; then
    local days
    days="$(days_since "$confirmed_at")"
    if [[ "$days" =~ ^[0-9]+$ ]]; then
      echo "CONFIRMED: $confirmed_at (${days}d ago)"
      # Risk #7 (vault-leak) staleness warning.
      if (( days > 30 )); then
        echo "WARNING: confirmation is >30 days old. Re-run \`kunskap learn enable --vault <path>\` to re-confirm the binding (Risk #7)." >&2
      fi
    else
      echo "CONFIRMED: $confirmed_at (age unparseable)"
    fi
  else
    echo "CONFIRMED: <unset>"
  fi
}

cmd_learn() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    enable)  cmd_learn_enable  "$@" ;;
    disable) cmd_learn_disable "$@" ;;
    status)  cmd_learn_status  "$@" ;;
    "")      die "learn: subcommand required (enable | disable | status)" ;;
    *)       die "learn: unknown subcommand: $sub" ;;
  esac
}

cmd_curate() {
  local vault="" check=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --check) check=true; shift ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "curate: --vault <abs-path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "curate: unknown extra args: ${extra[*]}"
  validate_vault "$vault"
  $check && { echo "kunskap: vault $vault looks healthy"; return 0; }

  local root prompt
  root="$(plugin_root)"
  [[ -f "$root/agents/curator.md" ]] \
    || die "curate: curator agent not found at $root/agents/curator.md (plugin_root resolved to $root; set CLAUDE_PLUGIN_ROOT to override)"
  command -v claude >/dev/null || die "curate: \`claude\` not on PATH; install Claude Code first"
  prompt="You have one task: invoke the \`curator\` subagent (defined in this plugin's agents/curator.md) via the Agent tool, passing this exact string as its ARGUMENTS:

$vault

The curator's system prompt already encodes the full §Curator contract — it knows what to do once it has the vault path. Do NOT attempt the curation work yourself; the curator subagent must own it. Do not write outside $vault. Do not modify this plugin repo. Report the curator's summary back when it returns."

  exec claude --plugin-dir "$root" --permission-mode acceptEdits -p "$prompt"
}

cmd_link_stubs() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "link-stubs: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "link-stubs: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "link-stubs: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # One pass: walk wiki/, harvest filename + aliases from frontmatter and
      # [[wikilinks]] from body in the same read. Frontmatter is the FIRST
      # ---/--- pair only; body --- separators stay body.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) {
        n = split(f, parts, "/")
        bn = parts[n]; sub(/\.md$/, "", bn)
        files[bn] = f
        in_fm = 0; fm_done = 0; ln = 0
        while ((getline line < f) > 0) {
          ln++
          if (!fm_done) {
            if (ln == 1) {
              if (line == "---") { in_fm = 1; continue }
              fm_done = 1
            } else if (in_fm && line == "---") {
              in_fm = 0; fm_done = 1; continue
            }
          }
          if (in_fm && line ~ /^aliases:/) {
            sub(/^aliases:[[:space:]]*\[?/, "", line)
            sub(/\]?[[:space:]]*$/, "", line)
            n2 = split(line, al, /,[[:space:]]*/)
            for (i = 1; i <= n2; i++) {
              gsub(/^"|"$|^'\''|'\''$/, "", al[i])
              if (al[i] != "") aliases[al[i]] = bn
            }
            continue
          }
          if (fm_done) {
            rest = line
            while (match(rest, /\[\[[^]]+\]\]/)) {
              link = substr(rest, RSTART + 2, RLENGTH - 4)
              sub(/\|.*$/, "", link)
              if (link != "") counts[link]++
              rest = substr(rest, RSTART + RLENGTH)
            }
          }
        }
        close(f)
      }
      close(cmd)

      if (outfmt == "json") printf "{\n"

      for (link in counts) {
        c = counts[link]
        kebab = link
        gsub(/[[:space:]]+/, "-", kebab); kebab = tolower(kebab)
        # Resolved: exact filename match OR an existing aliases: entry resolves it.
        # Needs-alias: kebab match exists but the natural-language form is not declared.
        if (link in files || link in aliases)        classify(link, c, "resolved")
        else if (kebab in files)                     classify(link, c, "needs-alias")
        else if (c >= 2)                             classify(link, c, "needs-stub")
        else                                          classify(link, c, "orphan")
      }

      if (outfmt == "json") {
        flush_json("resolved");  flush_json("needs-alias")
        flush_json("needs-stub"); flush_json("orphan")
        printf "\n}\n"
      } else {
        report("needs-stub",  "Multi-ref stubs (>=2 refs, no file) — write a concept stub:")
        report("orphan",      "Single-ref orphans (1 ref, no file) — leave as aspirational:")
        report("needs-alias", "Name-mismatch (kebab matches file, alias not declared) — curator should add aliases:")
        report("resolved",    "Resolved links — OK:")
      }
    }
    function classify(link, c, kind,    rec) {
      rec = link "\t" c
      buckets[kind] = buckets[kind] (buckets[kind] ? "\n" : "") rec
    }
    function flush_json(kind,    n, lines, i, sep, pair) {
      if (! (kind in buckets)) { printf "%s  \"%s\": []", (printed ? ",\n" : ""), kind; printed = 1; return }
      printf "%s  \"%s\": [", (printed ? ",\n" : ""), kind
      n = split(buckets[kind], lines, "\n")
      sep = ""
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        gsub(/\\/, "\\\\", pair[1]); gsub(/"/, "\\\"", pair[1])
        printf "%s\n    {\"link\": \"%s\", \"refs\": %d}", sep, pair[1], pair[2]
        sep = ","
      }
      printf "\n  ]"
      printed = 1
    }
    function report(kind, header,    n, lines, i, pair) {
      print header
      if (! (kind in buckets)) { print "  (none)\n"; return }
      n = split(buckets[kind], lines, "\n")
      for (i = 1; i <= n; i++) {
        split(lines[i], pair, "\t")
        printf "  [%dx] %s\n", pair[2], pair[1]
      }
      print ""
    }
  ' </dev/null
}

cmd_audit_coverage() {
  local vault="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault "${2-__MISSING__}"; vault="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ -n "$vault" ]] || die "audit-coverage: --vault <abs-path> is required"
  [[ "$format" == "text" || "$format" == "json" ]] || die "audit-coverage: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "audit-coverage: unknown extra args: ${extra[*]}"
  validate_vault "$vault"

  awk -v vault="$vault" -v outfmt="$format" '
    BEGIN {
      # 1. Collect all source files that exist (inbox + archive).
      collect_sources(vault "/raw/inbox",                "raw/inbox")
      collect_sources(vault "/Archives/processed-inbox", "Archives/processed-inbox")

      # 2. Collect every sources: entry from every wiki article.
      cmd = "find \"" vault "/wiki\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline f) > 0) parse_sources(f)
      close(cmd)

      # 3. Compute silent-drops + broken-provenance.
      n_drop = 0; n_broken = 0
      for (s in sources_present)        if (!(s in sources_cited)) drops[++n_drop] = s
      for (s in sources_cited)          if (!(s in sources_present)) broken[++n_broken] = s
      for (s in sources_cited)
        if (s in sources_present)
          covered[++n_cov] = s

      if (outfmt == "json") {
        printf "{\n  \"silent_drops\": ["
        for (i = 1; i <= n_drop; i++) printf "%s\"%s\"", (i>1?", ":""), drops[i]
        printf "],\n  \"broken_provenance\": ["
        for (i = 1; i <= n_broken; i++) printf "%s\"%s\"", (i>1?", ":""), broken[i]
        printf "],\n  \"covered_count\": %d\n}\n", n_cov
      } else {
        printf "Silent drops (file present, no article cites it):\n"
        if (n_drop == 0) print "  (none)"
        for (i = 1; i <= n_drop; i++) printf "  %s\n", drops[i]
        printf "\nBroken provenance (article cites missing file):\n"
        if (n_broken == 0) print "  (none)"
        for (i = 1; i <= n_broken; i++) printf "  %s\n", broken[i]
        printf "\nCovered: %d source files cited by at least one article.\n", n_cov
      }

      if (n_drop > 0 || n_broken > 0) exit 2
    }
    function collect_sources(dir, prefix,    cmd, line, base, rel) {
      cmd = "find \"" dir "\" -type f -name \"*.md\" 2>/dev/null"
      while ((cmd | getline line) > 0) {
        base = line
        sub(/.*\//, "", base)
        rel = prefix "/" base
        sources_present[rel] = 1
      }
      close(cmd)
    }
    function parse_sources(f,    line, infm, insrc) {
      infm = 0; insrc = 0
      while ((getline line < f) > 0) {
        if (line == "---") { if (!infm) infm = 1; else { close(f); return }; continue }
        if (!infm) continue
        if (line ~ /^sources:/) { insrc = 1
          # inline form: sources: [a, b]
          if (line ~ /\[/) {
            sub(/^sources:[[:space:]]*\[/, "", line)
            sub(/\][[:space:]]*$/, "", line)
            n = split(line, items, /,[[:space:]]*/)
            for (i = 1; i <= n; i++) {
              gsub(/^[[:space:]"'\'']+|[[:space:]"'\'']+$/, "", items[i])
              if (items[i] != "") sources_cited[items[i]] = 1
            }
            insrc = 0
          }
          continue
        }
        if (insrc) {
          if (line ~ /^[[:space:]]*-[[:space:]]/) {
            entry = line
            sub(/^[[:space:]]*-[[:space:]]*/, "", entry)
            gsub(/^["'\''[:space:]]+|["'\''[:space:]]+$/, "", entry)
            if (entry != "") sources_cited[entry] = 1
          } else if (line ~ /^[^[:space:]]/) {
            # next top-level key — sources block ended
            insrc = 0
          }
        }
      }
      close(f)
    }
  ' </dev/null
}

# ---------- init ----------

# Reject substitution inputs that would break the bash literal-substitution
# pass below or escape into shell-eval contexts when echoed back.
validate_template_input() {
  local label="$1" val="$2"
  [[ "$val" != *$'\n'* ]] || die "$label must not contain a newline"
  [[ "$val" != *'"'*   ]] || die "$label must not contain a double-quote"
  [[ "$val" != *\\* ]]    || die "$label must not contain a backslash"
}

substitute_template() {
  local file="$1" name="$2" created="$3" shared="$4"
  [[ -f "$file" ]] || return 0
  local content
  content="$(<"$file")"
  content="${content//\{\{name\}\}/$name}"
  content="${content//\{\{created\}\}/$created}"
  content="${content//\{\{shared\}\}/$shared}"
  printf '%s\n' "$content" > "$file"
}

write_sample_notes() {
  local abs="$1" created="$2"
  cat > "$abs/raw/inbox/example-${created}.md" <<EOF
---
type: learning
session: example
created: ${created}
suggested_topic: example-topic
sources:
  - thread: ~/.claude/projects/example
---

# Example inbox note

This is the shape that sessions write to \`raw/inbox/\`. The curator compiles
notes like this into wiki articles. Replace this file with your own captures
and run \`/kunskap:curate\` to see it process.
EOF

  cat > "$abs/Archives/processed-inbox/example-baseline-${created}.md" <<EOF
---
type: learning
session: example
created: ${created}
suggested_topic: example-topic
sources:
  - thread: ~/.claude/projects/example
---

# Example baseline note

Pre-curated seed. The wiki article at \`wiki/learnings/example-topic.md\`
cites this archived inbox file in its \`## Sources\` footer so
\`kunskap audit-coverage\` passes on a freshly-init'd vault.
EOF

  cat > "$abs/wiki/learnings/example-topic.md" <<EOF
---
type: learning
area: example
tags: [example]
created: ${created}
last_curated: ${created}
source_count: 1
sources:
  - Archives/processed-inbox/example-baseline-${created}.md
aliases: ["example topic"]
author: agent:kunskap-curator
---

# Example topic

This is the shape of a wiki article. The curator writes prose summarizing
inbox notes, with \`[[wikilinks]]\` to other topics and a per-source
\`## Sources\` footer. Replace or extend this with your own articles —
the curator owns this directory.

## Sources

### example-baseline-${created}.md

> Pre-curated seed. The wiki article at wiki/learnings/example-topic.md
> cites this archived inbox file in its ## Sources footer.

Original at Archives/processed-inbox/example-baseline-${created}.md
EOF
}

print_init_next_steps() {
  local abs="$1" shared_remote="$2"
  cat <<EOF
✓ Kunskap vault created: $abs

Next steps:
  cd "$abs"
  git status            # review what was scaffolded
  git add . && git commit -m "kunskap: vault scaffold"

Enable in a project:
  cd <some-project>
  /kunskap:learn enable --vault "$abs"

Roles (P5 will enforce):
  Edit "$abs/_meta/roles.toml" to declare curator + linter primaries
  using your \`kunskap whoami\` identity-string.
EOF
  if [[ -n "$shared_remote" ]]; then
    printf '\nShared remote configured: %s\n' "$shared_remote"
    printf '  After your first commit: git -C "%s" push -u origin main\n' "$abs"
  fi
}

cmd_init() {
  local target="" name="" shared_remote="" force=false yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shared) require_value --shared "${2-__MISSING__}"; shared_remote="$2"; shift 2 ;;
      --name)   require_value --name   "${2-__MISSING__}"; name="$2";          shift 2 ;;
      --force)  force=true; shift ;;
      --yes|-y) yes=true;   shift ;;
      --) shift; while [[ $# -gt 0 ]]; do extra+=("$1"); shift; done ;;
      -*) die "init: unknown flag: $1" ;;
      *)
        if [[ -z "$target" ]]; then target="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$target" ]] || die "init: <path> is required"
  [[ ${#extra[@]} -eq 0 ]] || die "init: unknown extra args: ${extra[*]}"

  [[ -n "$name" ]] && validate_template_input "--name" "$name"
  [[ -n "$shared_remote" ]] && validate_template_input "--shared" "$shared_remote"

  # Self-state checks before external (P1 §5): validate target before requiring
  # template dir or git on PATH, so users see the clearer error first.
  if [[ -e "$target" && ! -d "$target" ]]; then
    die "init: target exists and is not a directory: $target"
  fi
  if [[ -d "$target" && -n "$(ls -A "$target" 2>/dev/null)" ]]; then
    $force || die "init: target $target is non-empty (use --force to scaffold over it)"
    if ! $yes && [[ "${KUNSKAP_AUTO_CONFIRM:-}" != "1" ]]; then
      # Risk #7: scaffolding over a real project's files would be catastrophic.
      # Echo a labeled summary so a wrong-path mistake is obvious.
      {
        printf 'init: target is non-empty.\n'
        printf '  PATH:    %s\n' "$target"
        printf '  ENTRIES: %s\n' "$(find "$target" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
        printf 'Scaffold over it? (y/N) '
      } >&2
      local reply=""
      read -r reply || true
      [[ "$reply" =~ ^[Yy]$ ]] || die "init: cancelled"
    fi
  fi

  command -v git >/dev/null || die "init: \`git\` not on PATH; install git first"

  local root tpl
  root="$(plugin_root)"
  tpl="$root/templates/vault-init"
  [[ -d "$tpl" ]] || die "init: template directory not found at $tpl (set CLAUDE_PLUGIN_ROOT to override)"

  mkdir -p "$target"
  local abs
  abs="$(cd "$target" && pwd)"

  cp -R "$tpl/." "$abs/"

  local created shared_value effective_name
  created="$(date -u +%Y-%m-%d)"
  shared_value="false"
  [[ -n "$shared_remote" ]] && shared_value="true"
  effective_name="${name:-$(basename "$abs")}"

  for f in "$abs/_meta/kunskap.toml" "$abs/wiki/_index.md" "$abs/README.md"; do
    substitute_template "$f" "$effective_name" "$created" "$shared_value"
  done

  if [[ ! -d "$abs/.git" ]]; then
    git -C "$abs" init -q
  fi

  if [[ -n "$shared_remote" ]]; then
    if git -C "$abs" remote get-url origin >/dev/null 2>&1; then
      git -C "$abs" remote set-url origin "$shared_remote"
    else
      git -C "$abs" remote add origin "$shared_remote"
    fi
  fi

  write_sample_notes "$abs" "$created"

  print_init_next_steps "$abs" "$shared_remote"
}

# ---------- drafts ----------

# Resolve the vault: --vault wins; otherwise read .claude/kunskap.json from
# CLAUDE_PROJECT_DIR/PWD (matching hooks). Errors when neither resolves.
resolve_drafts_vault() {
  local explicit="$1" marker vault
  if [[ -n "$explicit" ]]; then
    [[ "$explicit" = /* ]] || die "drafts: --vault must be an absolute path (got: $explicit)"
    [[ -d "$explicit" ]] || die "drafts: vault path not found: $explicit"
    [[ -d "$explicit/wiki/_drafts" ]] || die "drafts: not a kunskap vault (missing wiki/_drafts/): $explicit"
    printf '%s\n' "$explicit"
    return 0
  fi
  marker="$(marker_path)"
  if [[ ! -f "$marker" ]]; then
    die "drafts: no --vault and no project marker at $marker; pass --vault <abs> or run \`kunskap learn enable\` first"
  fi
  vault="$(jq -r '.vault // ""' "$marker" 2>/dev/null || true)"
  [[ -n "$vault" ]] || die "drafts: marker $marker has no \`vault\` field"
  [[ -d "$vault" ]] || die "drafts: vault $vault from marker does not exist"
  [[ -d "$vault/wiki/_drafts" ]] || die "drafts: $vault is missing wiki/_drafts/ (run \`kunskap init\` to scaffold)"
  printf '%s\n' "$vault"
}

# List draft slugs (basename minus .md), sorted by created frontmatter date asc
# (oldest first), with .gitkeep filtered out.
list_draft_slugs() {
  local vault="$1"
  find "$vault/wiki/_drafts" -mindepth 1 -maxdepth 1 -name '*.md' -not -name '.gitkeep' 2>/dev/null \
    | while IFS= read -r f; do
        local created
        created="$(awk '
          /^---/ { fm++; next }
          fm == 1 && /^created:/ {
            sub(/^created:[[:space:]]*/, "")
            sub(/[[:space:]]*$/, "")
            print
            exit
          }
        ' "$f")"
        printf '%s\t%s\n' "${created:-9999-99-99}" "$f"
      done \
    | sort \
    | while IFS=$'\t' read -r _ f; do
        local b
        b="$(basename "$f")"
        printf '%s\n' "${b%.md}"
      done
}

read_frontmatter_field() {
  local file="$1" field="$2"
  awk -v f="$field" '
    /^---/ { fm++; next }
    fm == 1 && $0 ~ "^"f":" {
      sub("^"f":[[:space:]]*", "")
      sub(/[[:space:]]*$/, "")
      print
      exit
    }
  ' "$file"
}

count_sources() {
  local file="$1"
  awk '
    BEGIN { n = 0; insrc = 0 }
    /^---/ { fm++; if (fm == 2) exit; next }
    fm != 1 { next }
    /^sources:/ {
      insrc = 1
      if ($0 ~ /\[/) {
        s = $0
        sub(/^sources:[[:space:]]*\[/, "", s)
        sub(/\][[:space:]]*$/, "", s)
        if (s ~ /[^[:space:]]/) {
          n2 = split(s, items, /,[[:space:]]*/)
          for (i = 1; i <= n2; i++) if (items[i] ~ /[^[:space:]]/) n++
        }
        insrc = 0
      }
      next
    }
    insrc && /^[[:space:]]*-[[:space:]]/ { n++ }
    insrc && /^[^[:space:]]/ { insrc = 0 }
    END { print n }
  ' "$file"
}

# Resolve <id-or-slug> to absolute draft file path. <id> is 1-based index from
# `list_draft_slugs`. Bare slug match also works (full slug or prefix).
resolve_draft_id() {
  local vault="$1" needle="$2"
  [[ -n "$needle" ]] || die "drafts: <id> or <slug> required"
  # macOS ships bash 3.2 which has no `mapfile` — read into the array by hand.
  local slugs=() line
  while IFS= read -r line; do slugs+=("$line"); done < <(list_draft_slugs "$vault")
  local count=${#slugs[@]}
  if [[ "$needle" =~ ^[0-9]+$ ]]; then
    (( needle >= 1 && needle <= count )) || die "drafts: id $needle out of range (have $count)"
    printf '%s/wiki/_drafts/%s.md\n' "$vault" "${slugs[$((needle - 1))]}"
    return 0
  fi
  local match=""
  for s in "${slugs[@]}"; do
    if [[ "$s" == "$needle" ]]; then printf '%s/wiki/_drafts/%s.md\n' "$vault" "$s"; return 0; fi
  done
  for s in "${slugs[@]}"; do
    if [[ "$s" == "$needle"* ]]; then
      [[ -z "$match" ]] || die "drafts: slug prefix \"$needle\" matches multiple drafts"
      match="$s"
    fi
  done
  [[ -n "$match" ]] || die "drafts: no draft matching id-or-slug \"$needle\""
  printf '%s/wiki/_drafts/%s.md\n' "$vault" "$match"
}

# Pure-shell age in days from an ISO date frontmatter field. Returns "?" on
# parse failure. Reuses the same date-bridging shape as days_since().
draft_age_days() {
  local iso="$1"
  iso="${iso:0:10}"
  [[ "$iso" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "?"; return; }
  local now_epoch then_epoch
  now_epoch=$(date -u +%s)
  if   then_epoch=$(date -u -j -f "%Y-%m-%d" "$iso" +%s 2>/dev/null); then :
  elif then_epoch=$(date -u -d "$iso" +%s 2>/dev/null); then :
  else echo "?"; return
  fi
  printf '%d\n' "$(( (now_epoch - then_epoch) / 86400 ))"
}

cmd_drafts_list() {
  local vault_flag="" format="text" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --format) require_value --format "${2-__MISSING__}"; format="$2";     shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  [[ "$format" == "text" || "$format" == "json" ]] || die "drafts list: --format must be text or json (got: $format)"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts list: unknown extra args: ${extra[*]}"
  local vault
  vault="$(resolve_drafts_vault "$vault_flag")"

  local slugs=() line
  while IFS= read -r line; do slugs+=("$line"); done < <(list_draft_slugs "$vault")
  if [[ "$format" == "json" ]]; then
    printf '['
    local sep=""
    local idx=0
    for s in "${slugs[@]}"; do
      idx=$((idx + 1))
      local f="$vault/wiki/_drafts/$s.md"
      local conf reason created srcn age
      conf="$(read_frontmatter_field "$f" confidence)"
      reason="$(read_frontmatter_field "$f" reason)"
      created="$(read_frontmatter_field "$f" created)"
      srcn="$(count_sources "$f")"
      age="$(draft_age_days "$created")"
      conf="${conf//\"/\\\"}"
      reason="${reason//\"/\\\"}"
      printf '%s\n  {"id": %d, "slug": "%s", "confidence": "%s", "reason": "%s", "source_count": %d, "created": "%s", "age_days": "%s"}' \
        "$sep" "$idx" "$s" "$conf" "$reason" "$srcn" "$created" "$age"
      sep=","
    done
    printf '\n]\n'
    return 0
  fi

  if [[ ${#slugs[@]} -eq 0 ]]; then
    echo "kunskap: no drafts in $vault/wiki/_drafts/"
    return 0
  fi
  echo "kunskap: drafts in $vault/wiki/_drafts/ (oldest first)"
  local idx=0
  for s in "${slugs[@]}"; do
    idx=$((idx + 1))
    local f="$vault/wiki/_drafts/$s.md"
    local conf created srcn age
    conf="$(read_frontmatter_field "$f" confidence)"
    created="$(read_frontmatter_field "$f" created)"
    srcn="$(count_sources "$f")"
    age="$(draft_age_days "$created")"
    printf '  [%d] %s  conf=%s  src=%s  age=%sd\n' "$idx" "$s" "${conf:-?}" "$srcn" "$age"
  done
}

cmd_drafts_show() {
  local vault_flag="" needle="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts show: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts show: unknown extra args: ${extra[*]}"
  local vault f
  vault="$(resolve_drafts_vault "$vault_flag")"
  f="$(resolve_draft_id "$vault" "$needle")"
  echo "# $(basename "$f" .md)"
  echo "# path: $f"
  echo
  cat "$f"
}

git_commit_drafts_action() {
  local vault="$1" msg="$2"
  [[ -d "$vault/.git" ]] || return 0
  # `git add -A` for the two pathspecs picks up adds, modifies, and deletions.
  # Plain `git add` skips deletions, which would leave _drafts/<slug>.md
  # tracked-but-missing after approve/reject and split the commit in two.
  git -C "$vault" add -A wiki Archives 2>/dev/null || true
  if git -C "$vault" diff --cached --quiet; then return 0; fi
  # Vault may not have a committer configured (e.g. fresh `kunskap init`); fall
  # back to a kunskap@local identity for this single commit so triage isn't
  # blocked. Real users almost always have a global git config — we only hit
  # this in tests + the first-touch-after-init path.
  if ! git -C "$vault" commit -q -m "$msg" 2>/dev/null; then
    git -C "$vault" -c user.email=kunskap@local -c user.name=kunskap \
       -c commit.gpgsign=false commit -q -m "$msg"
  fi
}

cmd_drafts_approve() {
  local vault_flag="" needle="" into="" yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --into)  require_value --into  "${2-__MISSING__}"; into="$2";       shift 2 ;;
      --yes|-y) yes=true; shift ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts approve: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts approve: unknown extra args: ${extra[*]}"
  local vault src slug today
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"
  today="$(date -u +%Y-%m-%d)"

  local dest_article archive
  archive="$vault/Archives/processed-drafts/approved/$slug.md"
  mkdir -p "$vault/wiki/learnings" "$vault/Archives/processed-drafts/approved"

  # Privacy / safety: --into <slug> requires the target article to already
  # exist; we never silently create one under the user's nose.
  if [[ -n "$into" ]]; then
    dest_article="$vault/wiki/learnings/${into}.md"
    [[ -f "$dest_article" ]] || die "drafts approve: --into target $dest_article does not exist; create it first or omit --into"
    {
      printf '\n### %s — promoted from drafts/%s\n\n' "$today" "$slug"
      sed -n '/^---$/,/^---$/!p' "$src"
    } >> "$dest_article"
  else
    dest_article="$vault/wiki/learnings/${slug}.md"
    [[ ! -f "$dest_article" ]] || die "drafts approve: $dest_article already exists; pass --into <slug> to merge instead"
    # Strip drafts-only frontmatter fields when promoting to a learnings article.
    awk -v today="$today" '
      BEGIN { fm = 0; in_fm = 0 }
      /^---$/ {
        fm++
        if (fm == 1) { in_fm = 1; print; next }
        if (fm == 2) { print "last_curated: " today; in_fm = 0; print; next }
        print; next
      }
      in_fm {
        if ($0 ~ /^(confidence|reason|deferred_at|approved_at|rejection_reason|lane):/) next
        if ($0 ~ /^type:[[:space:]]*draft[[:space:]]*$/) { print "type: learning"; next }
      }
      { print }
    ' "$src" > "$dest_article"
  fi

  # Archive: we copy the source to the archive (rather than git mv) so the
  # archived form can carry an `approved_at:` stamp that points at the
  # original draft body without disturbing the promoted article's frontmatter.
  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v target="${into:-$slug}" '
    BEGIN { fm = 0 }
    /^---$/ {
      fm++
      print
      if (fm == 1) {
        print "approved_at: " ts
        print "approved_into: " target
      }
      next
    }
    { print }
  ' "$src" > "$archive"
  rm -f "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts approve $slug${into:+ → $into}"
  echo "kunskap: approved $slug → $dest_article"
  echo "         archived original at $archive"
  $yes || true
}

cmd_drafts_reject() {
  local vault_flag="" needle="" reason="" yes=false extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)  require_value --vault  "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      --reason) require_value --reason "${2-__MISSING__}"; reason="$2";     shift 2 ;;
      --yes|-y) yes=true; shift ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts reject: <id> or <slug> required"
  [[ -n "$reason" ]] || die "drafts reject: --reason \"<why>\" is required (rejection without reason loses context)"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts reject: unknown extra args: ${extra[*]}"
  validate_template_input "--reason" "$reason"
  local vault src slug archive
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"
  archive="$vault/Archives/processed-drafts/rejected/$slug.md"
  mkdir -p "$vault/Archives/processed-drafts/rejected"
  [[ ! -e "$archive" ]] || die "drafts reject: $archive already exists (slug collision)"

  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v reason="$reason" '
    BEGIN { fm = 0 }
    /^---$/ {
      fm++
      print
      if (fm == 1) {
        print "rejected_at: " ts
        print "rejection_reason: \"" reason "\""
      }
      next
    }
    { print }
  ' "$src" > "$archive"
  rm -f "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts reject $slug — $reason"
  echo "kunskap: rejected $slug → $archive"
  $yes || true
}

cmd_drafts_defer() {
  local vault_flag="" needle="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault) require_value --vault "${2-__MISSING__}"; vault_flag="$2"; shift 2 ;;
      *)
        if [[ -z "$needle" ]]; then needle="$1"; shift
        else extra+=("$1"); shift
        fi
        ;;
    esac
  done
  [[ -n "$needle" ]] || die "drafts defer: <id> or <slug> required"
  [[ ${#extra[@]} -eq 0 ]] || die "drafts defer: unknown extra args: ${extra[*]}"
  local vault src slug
  vault="$(resolve_drafts_vault "$vault_flag")"
  src="$(resolve_draft_id "$vault" "$needle")"
  slug="$(basename "$src" .md)"

  local tmp
  tmp="$(mktemp)"
  awk -v ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    BEGIN { fm = 0; stamped = 0 }
    /^---$/ {
      fm++
      if (fm == 2 && !stamped) { print "deferred_at: " ts; stamped = 1 }
      print
      next
    }
    fm == 1 && /^deferred_at:/ { next }
    { print }
  ' "$src" > "$tmp"
  mv "$tmp" "$src"

  git_commit_drafts_action "$vault" "kunskap: drafts defer $slug"
  echo "kunskap: deferred $slug (stamped deferred_at; left in _drafts/)"
}

cmd_drafts() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list)    cmd_drafts_list    "$@" ;;
    show)    cmd_drafts_show    "$@" ;;
    approve) cmd_drafts_approve "$@" ;;
    reject)  cmd_drafts_reject  "$@" ;;
    defer)   cmd_drafts_defer   "$@" ;;
    *)       die "drafts: unknown subcommand: $sub (try list | show | approve | reject | defer)" ;;
  esac
}

main() {
  # Pre-dispatch globals are consumed only when they precede the first
  # non-flag token; subcommand-local `--vault` (curate, learn enable) is
  # still parsed inside the subcommand.
  while [[ $# -gt 0 && "$1" == --vault ]]; do
    require_value --vault "${2-__MISSING__}"
    GLOBAL_VAULT="$2"
    shift 2
  done

  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    version|--version)        echo "kunskap $VERSION" ;;
    help|--help|-h)           cmd_help ;;
    init)                     cmd_init "$@" ;;
    config)                   cmd_config "$@" ;;
    whoami)                   cmd_whoami "$@" ;;
    learn)                    cmd_learn "$@" ;;
    curate)                   cmd_curate "$@" ;;
    drafts)                   cmd_drafts "$@" ;;
    link-stubs)               cmd_link_stubs "$@" ;;
    audit-coverage)           cmd_audit_coverage "$@" ;;
    *) die "unknown subcommand: $cmd (try \`kunskap help\`)" ;;
  esac
}

main "$@"
